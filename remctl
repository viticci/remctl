class C:
    """ANSI color helpers. Respects NO_COLOR env and --no-color flag."""
    enabled = True

    @staticmethod
    def _c(code, text):
        return f"\033[{code}m{text}\033[0m" if C.enabled else str(text)

    @staticmethod
    def red(t): return C._c("31", t)
    @staticmethod
    def green(t): return C._c("32", t)
    @staticmethod
    def yellow(t): return C._c("33", t)
    @staticmethod
    def blue(t): return C._c("34", t)
    @staticmethod
    def magenta(t): return C._c("35", t)
    @staticmethod
    def cyan(t): return C._c("36", t)
    @staticmethod
    def dim(t): return C._c("2", t)
    @staticmethod
    def bold(t): return C._c("1", t)
    @staticmethod
    def strikethrough(t): return C._c("9", t)
    @staticmethod
    def rgb(r, g, b, t):
        return f"\033[38;2;{r};{g};{b}m{t}\033[0m" if C.enabled else str(t)


TERMINAL_CONTROL_RE = re.compile(r"[\x00-\x1f\x7f-\x9f\u2028\u2029]")


def safe_display(value):
    """Return text safe to print in a terminal while preserving JSON/raw data."""
    if value is None:
        return ""
    return TERMINAL_CONTROL_RE.sub(" ", str(value))


def confirm_destructive_action(a, prompt, *, identifier=None, cancel_message="Cancelled."):
    """Confirm only in an interactive human session; keep JSON output deterministic."""
    if getattr(a, "force", False):
        return True
    json_mode = bool(getattr(a, "json", False))
    if json_mode or not sys.stdin.isatty():
        message = "Refusing to continue without --force when --json is used or stdin is not interactive."
        if json_mode:
            payload = {
                "status": "error",
                "code": "confirmation_required",
                "message": message,
            }
            if isinstance(identifier, list):
                payload["ids"] = identifier
            elif identifier is not None:
                payload["id"] = identifier
            print(json.dumps(payload, ensure_ascii=False), file=sys.stderr)
        else:
            print(f"Error: {message}", file=sys.stderr)
        raise SystemExit(1)

    print(prompt, end="", file=sys.stderr, flush=True)
    answer = sys.stdin.readline()
    if not answer:
        print("Error: confirmation input ended before an answer was received.", file=sys.stderr)
        raise SystemExit(1)
    if answer.strip().lower() not in {"y", "yes"}:
        print(cancel_message)
        return False
    return True

