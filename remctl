def cmd_add(a):
    refuse_private_args_without_opt_in(a)
    title = a.title
    wants_private = private_metadata_enabled(a) and private_changes_from_args(a)
    dt = parse_due(a.due)
    if a.due and not dt:
        fail_invalid_due_date(a.due, json_mode=getattr(a, "json", False))
    due_all_day = bool(dt and due_spec_is_all_day(a.due))
    parsed_recurrence = None
    if hasattr(a, 'recurrence') and a.recurrence:
        parsed_recurrence = recurrence_or_die(a.recurrence)
    parsed_alarm = None
    if hasattr(a, 'alarm') and a.alarm:
        parsed_alarm = parse_alarm(a.alarm)
        if parsed_alarm is None:
            print(f"Error: could not parse alarm {a.alarm!r}. Use 15m, 1h, 1d, or an absolute date.", file=sys.stderr)
            sys.exit(1)
    pm = {"high": 1, "h": 1, "medium": 5, "med": 5, "m": 5, "low": 9, "l": 9, "none": 0}
    priority_value = None
    if a.priority:
        priority_value = pm.get(a.priority.lower())
        if priority_value is None:
            print("Error: priority must be high, medium, low, or none.", file=sys.stderr)
            sys.exit(1)
    if early_reminder_requires_due_date(a) and dt is None:
        fail_early_reminder_without_due(json_mode=getattr(a, "json", False))
    if alarm_is_relative(parsed_alarm) and dt is None:
        fail_relative_alarm_without_due(json_mode=getattr(a, "json", False))
    if wants_private and not bridge_available():
        print("Error: private metadata creation requires remctl-bridge so the reminder has a stable ID.", file=sys.stderr)
        sys.exit(1)
    if wants_private:
        require_private_metadata(a)
        validate_private_args(a)
        if subtask_specs_need_bridge(parse_subtask_specs(getattr(a, "subtask", None))) and not bridge_available():
            print("Error: rich private subtasks require remctl-bridge for notes, due dates, priority, recurrence, or alarms.", file=sys.stderr)
            sys.exit(1)
    db = None
    target_list_pk = None
    target_list_name = getattr(a, "list", None)
    list_resolution = None
    list_id = getattr(a, "list_id", None)
    if target_list_name or list_id is not None:
        try:
            db = open_db()
            list_resolution = resolve_list_or_die(db, name=target_list_name, list_id=list_id)
            target_list_pk = list_resolution["id"]
            target_list_name = list_resolution["title"]
        except RemindersDBUnavailable:
            if list_id is not None or wants_private:
                raise
            target_list_name = getattr(a, "list", None)
    if getattr(a, "grocery", False):
        if target_list_pk is None:
            print("Error: --grocery requires a target Groceries list via -l/--list or --list-id.", file=sys.stderr)
            sys.exit(1)
        require_grocery_list_target(db, target_list_pk)

    if wants_private:
        if db is None:
            db = open_db()
        validate_private_add_ready(a, db, target_list_pk)
        # Last check before the reminder exists: a failed lookup creates nothing.
        resolve_location_address_or_die(a)

    if a.tags and not wants_private:
        for t in a.tags.split(","):
            t = t.strip()
            h = t if t.startswith("#") else f"#{t}"
            if h not in title:
                title += f" {h}"
    # Try bridge first
    bridge_result = None
    if bridge_available():
        data = {"action": "create", "title": title}
        if list_resolution:
            data.update(bridge_list_target_payload(list_resolution))
        elif target_list_name:
            data["list"] = target_list_name
        if a.notes: data["notes"] = a.notes
        if dt:
            data["due"] = dt.isoformat()
            if due_all_day:
                data["allDay"] = True
        if priority_value is not None:
            data["priority"] = priority_value
        if hasattr(a, 'url') and a.url and not wants_private: data["url"] = a.url
        if parsed_recurrence is not None:
            data["recurrence"] = parsed_recurrence
        if parsed_alarm is not None:
            data["alarm"] = parsed_alarm
        bridge_result = bridge_call_result(data)
        if bridge_result_ok(bridge_result, "created"):
            result = bridge_result["payload"]
            private_results = []
            created_row = None
            if wants_private:
                if db is None:
                    db = open_db()
                try:
                    created_row = q_reminder_by_identifier(db, result.get("id", ""))
                except RemindersDBUnavailable:
                    created_row = None
                partial_context = {
                    "id": result.get("id", ""),
                    "numericId": created_row["Z_PK"] if created_row else None,
                    "json": bool(getattr(a, "json", False)),
                    "completed": [],
                }
                private_results = apply_private_changes(
                    result.get("id", ""),
                    a,
                    db=db,
                    list_pk=target_list_pk,
                    partial_context=partial_context,
                )
            else:
                try:
                    if db is None:
                        db = open_db()
                    created_row = q_reminder_by_identifier(db, result.get("id", ""))
                except RemindersDBUnavailable:
                    created_row = None
            flag_error = None
            if a.flag and not wants_private:
                flag_ok, flag_err = osa_set_flagged_result(result.get("id", ""), flagged=True)
                if not flag_ok:
                    flag_error = flag_err
                    print(
                        "Warning: created the reminder but failed to set the flag via AppleScript: "
                        f"{flag_err}",
                        file=sys.stderr,
                    )
            if a.json:
                payload = {"status": "created", "id": result.get("id", ""), "title": title}
                if list_resolution and list_resolution.get("method") != "exact":
                    payload["resolvedList"] = {
                        "requested": list_resolution.get("requested"),
                        "title": list_resolution["title"],
                        "id": list_resolution["id"],
                        "method": list_resolution["method"],
                    }
                if created_row:
                    payload["numericId"] = created_row["Z_PK"]
                if private_results:
                    payload["private"] = private_results
                if flag_error is not None:
                    payload["warnings"] = [f"flag_not_set: {flag_error}"]
                print(json.dumps(payload))
            else:
                print(f"Created: {safe_display(title)}")
                if list_resolution and list_resolution.get("method") != "exact":
                    print(f"List: {safe_display(list_resolution['title'])} (resolved from {safe_display(list_resolution['requested'])})")
                if created_row:
                    print(f"ID: #{created_row['Z_PK']}")
                if private_results:
                    print(f"Private metadata: applied {len(private_results)} update{'s' if len(private_results) != 1 else ''}")
            return
        if bridge_failure_is_access_error(bridge_result):
            fail_bridge_write(bridge_result, operation="create the reminder")
        if bridge_failure_is_execution_error(bridge_result):
            fail_bridge_write(bridge_result, operation="create the reminder")
        if wants_private or parsed_recurrence is not None or parsed_alarm is not None:
            fail_bridge_write(bridge_result, operation="create the reminder")

    recovered_row = None
    if bridge_result and bridge_result.get("returncode") != 0:
        try:
            if db is None:
                db = open_db()
            recovered_row = q_recent_reminder_by_title(db, title, list_pk=target_list_pk)
        except RemindersDBUnavailable:
            recovered_row = None
    if recovered_row:
        result = {"id": recovered_row["ZCKIDENTIFIER"] or "", "status": "created"}
        created_row = recovered_row
        if a.json:
            payload = {"status": "created", "id": result.get("id", ""), "title": title}
            if list_resolution and list_resolution.get("method") != "exact":
                payload["resolvedList"] = {
                    "requested": list_resolution.get("requested"),
                    "title": list_resolution["title"],
                    "id": list_resolution["id"],
                    "method": list_resolution["method"],
                }
            if created_row:
                payload["numericId"] = created_row["Z_PK"]
            print(json.dumps(payload))
        else:
            print(f"Created: {safe_display(title)}")
            if list_resolution and list_resolution.get("method") != "exact":
                print(f"List: {safe_display(list_resolution['title'])} (resolved from {safe_display(list_resolution['requested'])})")
            if created_row:
                print(f"ID: #{created_row['Z_PK']}")
        return

    if dt and due_all_day:
        message = "All-day due dates require remctl-bridge so Reminders can store date-only components."
        if getattr(a, "json", False):
            print(json.dumps({"status": "error", "code": "bridge_required_for_all_day", "message": message}), file=sys.stderr)
        else:
            print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)

    # Fall back to AppleScript. Warn about fields AppleScript can't express,
    # so users don't silently lose url/recurrence/alarm when the bridge is
    # unavailable.
    if bridge_result and bridge_result.get("returncode") != 0:
        print(
            "Warning: remctl-bridge failed while creating the reminder; "
            f"falling back to AppleScript for basic fields only. Bridge error: {bridge_failure_message(bridge_result)}",
            file=sys.stderr,
        )
    dropped = []
    if hasattr(a, 'url') and a.url: dropped.append("url")
    if hasattr(a, 'recurrence') and a.recurrence: dropped.append("recurrence")
    if hasattr(a, 'alarm') and a.alarm: dropped.append("alarm")
    if dropped:
        print(
            f"Warning: bridge unavailable; {', '.join(dropped)} "
            "cannot be set via AppleScript and will be dropped.",
            file=sys.stderr,
        )
    lst = f'tell list "{esc(target_list_name)}"' if target_list_name else "tell default list"
    s = f'tell application "Reminders"\n{lst}\nset r to make new reminder with properties {{name:"{esc(title)}"}}\n'
    if a.notes: s += f'set body of r to "{esc(a.notes)}"\n'
    if priority_value is not None:
        s += f"set priority of r to {priority_value}\n"
    if a.flag: s += "set flagged of r to true\n"
    if dt: s += as_date_assign(dt) + "\n"
    s += "return id of r\nend tell\nend tell"
    rid = osa(s)
    if a.json:
        print(json.dumps({"status": "created", "id": rid, "title": title}))
    else:
        print(f"Created: {safe_display(title)}")

def _rem_id(r):
    """Build the x-apple-reminder:// ID that AppleScript uses for matching."""
    return f"x-apple-reminder://{r['ZCKIDENTIFIER']}" if r["ZCKIDENTIFIER"] else None


def _refuse_unsafe_title_fallback(reminder, operation, reason):
    title = safe_display(reminder["ZTITLE"] or "(untitled)")
    try:
        reminder_id = reminder["Z_PK"]
    except Exception:
        reminder_id = "?"
    print(
        f"Error: {reason}. Refusing unsafe title-based fallback for "
        f"#{reminder_id} ('{title}') while trying to {operation}.",
        file=sys.stderr,
    )
    sys.exit(1)

REMINDER_BATCH_MAX = 50
# No new write starts after this many seconds, so a batch finishes, and prints
# every result, well inside the MCP server's 300-second limit for these tools.
REMINDER_BATCH_BUDGET_SECONDS = 60

# bridge action, bridge success status, AppleScript statement, error-message verb
STATE_WRITES = {
    "done": ("complete", "completed", "set completed of r to true", "complete it"),
    "undone": ("uncomplete", "uncompleted", "set completed of r to false", "uncomplete it"),
    "delete": ("delete", "deleted", "delete r", "delete it"),
}


def bridge_outcome_uncertain(result):
    """True unless a failed remctl-bridge call proves that nothing was saved.

    Only two failures prove it: the bridge never started, or it exited nonzero
    after printing its own {"status": "error"} report. A timeout, a crash, a
    success report followed by a crash, or an exit 0 without the expected
    status can all come after EventKit committed.
    """
    if not result:
        return False
    payload = result.get("payload")
    status = payload.get("status") if isinstance(payload, dict) else None
    if status in {"missing_bridge", "exec_error"}:
        return False
    try:
        reported = json.loads(result.get("stdout") or "")
    except (TypeError, ValueError):
        reported = None
    reported_error = isinstance(reported, dict) and reported.get("status") == "error"
    return not (result.get("returncode") != 0 and reported_error)


def bridge_timed_out(result):
    payload = result.get("payload") if isinstance(result, dict) else None
    return isinstance(payload, dict) and payload.get("status") == "timeout"


def write_reminder_state(r, operation, *, completion_dt=None, completion_iso=None):
    """Complete, uncomplete, or delete one reminder row and report what happened.

    Returns {"outcome": "ok" | "failed" | "uncertain", ...}, plus
    "stalled": True when the bridge timed out, which tells a batch to stop.
    "failed" means nothing was written; "uncertain" means a write may have
    landed, so the caller must check before retrying. The AppleScript fallback
    runs only when repeating the write is harmless: it never follows an
    uncertain bridge result for a repeating reminder's completion, because
    every completion advances the series by one occurrence.
    """
    bridge_action, success_status, statement, _verb = STATE_WRITES[operation]
    recurring = operation == "done" and _row_get(r, "recurrence_frequency") is not None
    bridge_uncertain = stalled = False
    if bridge_available() and r["ZCKIDENTIFIER"]:
        data = {"action": bridge_action, "id": r["ZCKIDENTIFIER"]}
        if completion_iso:
            data["completionDate"] = completion_iso
        result = bridge_call_result(data)
        if bridge_result_ok(result, success_status):
            return {"outcome": "ok"}
        bridge_uncertain = bridge_outcome_uncertain(result)
        stalled = bridge_timed_out(result)
        if bridge_uncertain and recurring:
            return {**state_write_uncertain(r, operation, recurring=True), "stalled": stalled}

    rid = _rem_id(r)
    if not rid:
        return {"outcome": "failed", "code": "no_stable_identifier", "reason": "The reminder has no stable identifier", "stalled": stalled}
    action = statement
    if completion_dt:
        action += "\n" + as_date_assign(completion_dt, "completion date of r")
    details = {}
    if osa_by_id_try(rid, action, outcome=details):
        return {"outcome": "ok", "stalled": stalled}
    if bridge_uncertain or details.get("timedOut"):
        return {**state_write_uncertain(r, operation, recurring=recurring), "stalled": stalled}
    return {"outcome": "failed", "code": "write_failed", "reason": "Identifier-based writes failed", "stalled": stalled}


def state_write_uncertain(r, operation, *, recurring=False):
    reminder_id = _row_get(r, "Z_PK", "?")
    title = safe_display(_row_get(r, "ZTITLE") or "(untitled)")
    verb = STATE_WRITES[operation][3]
    if recurring:
        message = (
            f"RemCTL could not confirm whether #{reminder_id} ('{title}') was completed. It repeats, "
            "so completing it again could skip an occurrence. "
            f"Check it with `remctl info {reminder_id}` before retrying."
        )
        code = "completion_uncertain"
    else:
        message = (
            f"RemCTL could not confirm whether it managed to {verb} for #{reminder_id} ('{title}'). "
            f"Check it with `remctl info {reminder_id}` before retrying."
        )
        code = "write_uncertain"
    return {"outcome": "uncertain", "code": code, "message": message}


def fail_state_write(a, r, operation, outcome):
    """Exit for a single-reminder write that did not succeed."""
    if outcome["outcome"] == "failed":
        _refuse_unsafe_title_fallback(r, STATE_WRITES[operation][3], outcome["reason"])
    if getattr(a, "json", False):
        print(json.dumps({
            "status": "error",
            "code": outcome["code"],
            "message": outcome["message"],
            "id": _row_get(r, "Z_PK"),
        }), file=sys.stderr)
    else:
        print(f"Error: {outcome['message']}", file=sys.stderr)
    sys.exit(1)


def requested_reminder_ids(a):
    """Every id the command received, in order, repeats included."""
    return [a.id, *(getattr(a, "more_ids", None) or [])]


def completion_date_or_die(a):
    completion_arg = getattr(a, "date", None)
    if not completion_arg:
        return None, None
    completion_dt = parse_completion_date(completion_arg)
    if not completion_dt:
        fail_invalid_completion_date(completion_arg, json_mode=getattr(a, "json", False))
    return completion_dt, completion_dt.isoformat()


def cmd_done(a):
    if getattr(a, "batch", False) or len(requested_reminder_ids(a)) > 1:
        run_reminder_state_batch(a, "done")
        return
    db = open_db()
    r = q_reminder(db, a.id)
    if not r:
        print(f"Error: #{a.id} not found", file=sys.stderr)
        sys.exit(1)

    completion_dt, completion_iso = completion_date_or_die(a)
    if completion_iso and _row_get(r, "recurrence_frequency") is not None:
        message = (
            "--date is not supported for recurring reminders. "
            f"Use 'remctl done {a.id}' without --date to advance the series."
        )
        if getattr(a, "json", False):
            print(json.dumps({
                "status": "error",
                "code": "completion_date_unsupported_for_recurring",
                "message": message,
                "id": a.id,
            }), file=sys.stderr)
        else:
            print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)

    # Bridge-first for speed (post-2026-04-17 bridge fix: dueDateComponents
    # now reach CloudKit correctly). AppleScript stays as a fallback.
    outcome = write_reminder_state(r, "done", completion_dt=completion_dt, completion_iso=completion_iso)
    if outcome["outcome"] != "ok":
        fail_state_write(a, r, "done", outcome)
    if a.json:
        payload = {"status": "completed", "id": a.id, "title": r["ZTITLE"]}
        if completion_iso:
            payload["completionDate"] = completion_iso
        print(json.dumps(payload))
    else:
        suffix = f" ({completion_iso})" if completion_iso else ""
        print(f"Completed: {safe_display(r['ZTITLE'])}{suffix}")

