        return None
    try:
        data = bytes(blob)
        if data.startswith(b"\x01"):
            data = data[1:]
        payload = json.loads(data.decode("utf-8"))
        return payload if isinstance(payload, dict) else None
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
        return None


