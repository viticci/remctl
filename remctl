def resolve_list_ref(db, name=None, list_id=None, *, allow_groups=False):
    if list_id is not None:
        columns = list_select_columns(db)
        row = db.execute(
            f"SELECT {', '.join(columns)} FROM ZREMCDBASELIST "
            "WHERE Z_PK = ? AND ZMARKEDFORDELETION = 0 AND Z_ENT = 3 "
            "AND ZNAME IS NOT NULL AND ZNAME != ''",
            (list_id,),
        ).fetchone()
        if not row:
            return None
        if is_group_list_row(row):
            if allow_groups:
                return list_group_ref_payload(db, row, requested=str(list_id), method="id")
            return {
                "error": "group",
                "requested": str(list_id),
                "group": list_group_ref_payload(db, row, requested=str(list_id), method="id"),
            }
        return list_ref_payload(row, requested=str(list_id), method="id")

    if not name:
        return None

    result = list_resolution_from_rows(q_lists(db), name, list_ref_payload)
    if result:
        return result
    group_result = list_resolution_from_rows(
        q_list_groups(db),
        name,
        lambda row, **kwargs: list_group_ref_payload(db, row, **kwargs),
    )
    if group_result:
        if allow_groups or group_result.get("error"):
            return group_result
        return {
            "error": "group",
            "requested": name,
            "group": group_result,
        }
    return None

def _print_list_resolution_error(requested, result=None, *, json_mode=False):
    code = "list_not_found"
    if result and result.get("error") == "ambiguous":
        code = "list_ambiguous"
        options = ", ".join(
            f"{candidate['id']} ({candidate['title']})"
            for candidate in result.get("candidates", [])
        )
        message = f"multiple lists match {requested!r}. Use the exact list name or --list-id with one of: {options}"
    elif result and result.get("error") == "group":
        code = "list_is_group"
        group = result.get("group", {})
        title = group.get("title") or requested
        children = group.get("children") or []
        message = f"{title!r} is a Reminders list group, not a writable list."
        if children:
            options = ", ".join(f"{child['title']} (id {child['id']})" for child in children)
            message += f" Use one of its child lists: {options}"
    else:
        message = f"list not found: {requested}"
    if json_mode:
        print(json.dumps({"status": "error", "code": code, "message": message}), file=sys.stderr)
    else:
        print(f"Error: {message}", file=sys.stderr)

def resolve_list_or_die(db, name=None, list_id=None, *, allow_groups=False, json_mode=False):
    result = resolve_list_ref(db, name=name, list_id=list_id, allow_groups=allow_groups)
    if result and not result.get("error"):
        return result
    requested = f"id {list_id}" if list_id is not None else name
    _print_list_resolution_error(requested, result, json_mode=json_mode)
    sys.exit(1)

def resolve_required_list_target_or_die(db, *, name=None, list_id=None, allow_groups=False, json_mode=False):
    if (name and list_id is not None) or (not name and list_id is None):
        message = "pass either a list name or --list-id, not both." if name else "pass a list name or --list-id."
        if json_mode:
            print(json.dumps({"status": "error", "code": "invalid_list_target", "message": message}), file=sys.stderr)
        else:
            print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)
    return resolve_list_or_die(db, name=name, list_id=list_id, allow_groups=allow_groups, json_mode=json_mode)



