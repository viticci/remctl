def tailscale_state_text(ts):
    if not ts.get("installed"):
        return C.dim("Tailscale not installed")
    if ts.get("configured"):
        if ts.get("active") and ts.get("agentInterpreterProblem"):
            reason = MCP_STALE_REASONS.get(ts["agentInterpreterProblem"], MCP_STALE_REASONS["interpreter_missing"])
            return C.yellow(f"serving at {ts.get('url')}, but the service {reason}; rerun `remctl mcp install --client tailscale`")
        if ts.get("active"):
            return C.green(f"serving at {ts.get('url')}")
        return C.yellow("configured but not running; run `remctl mcp install --client tailscale` to repair")
    if not ts.get("running"):
        return C.yellow("Tailscale is not connected; open Tailscale and sign in")
    return C.dim("available; run `remctl mcp install --client tailscale`")


