# ── Address-based location alarms ────────────────────────────────────────────

LOCATION_MAX_RADIUS = 100_000.0  # meters; remctl-bridge refuses anything larger
GEOCODE_TIMEOUT_SECONDS = 10
GEOCODE_MAX_PRECISE_RADIUS = 1000.0  # meters; a larger match covers a whole area
# Words that name a place only the user knows. Geocoding them would pick some
# unrelated spot that happens to share the name.
PERSONAL_PLACE_LABELS = frozenset({
    "home", "my home", "house", "my house", "my place", "work", "my work", "office", "my office",
    "school", "my school", "gym", "my gym", "here", "current location", "my location",
})


def fail_location(a, code, message, **extra):
    """Stop before any write, with a structured error in --json mode."""
    if getattr(a, "json", False):
        print(json.dumps({"status": "error", "code": code, "message": message, **extra}, ensure_ascii=False), file=sys.stderr)
    else:
        print(f"Error: {message}", file=sys.stderr)
        for candidate in extra.get("candidates") or []:
            label = candidate.get("address") or candidate.get("name") or "?"
            print(
                f"  {safe_display(label)} ({candidate['latitude']:.5f}, {candidate['longitude']:.5f}; {candidate['precision']})",
                file=sys.stderr,
            )
    sys.exit(1)


def is_personal_place_label(value):
    text = re.sub(r"[^\w\s]", "", str(value or "")).strip()
    return " ".join(text.casefold().split()) in PERSONAL_PLACE_LABELS


def geocoded_candidate(raw):
    """A bridge geocoder match, reduced to what the user reviews, with its precision.

    Street addresses come back with a region of about 70 m. A city or region
    comes back as one best guess with a region several kilometers wide, so the
    region size, not the number of matches, is what exposes a vague query.
    """
    radius = raw.get("regionRadius")
    radius = float(radius) if isinstance(radius, (int, float)) and not isinstance(radius, bool) else None
    if radius is not None and radius > GEOCODE_MAX_PRECISE_RADIUS:
        precision = "area"
    elif raw.get("thoroughfare"):
        precision = "street"
    elif raw.get("areasOfInterest") or radius is not None:
        precision = "place"
    else:
        precision = "area"
    candidate = {
        "name": raw.get("name"),
        "address": raw.get("address"),
        "latitude": float(raw["latitude"]),
        "longitude": float(raw["longitude"]),
        "precision": precision,
    }
    if radius is not None:
        candidate["regionRadius"] = round(radius, 1)
    return {key: value for key, value in candidate.items() if value is not None}


STREET_ABBREVIATIONS = {
    "st": "street", "str": "street", "ave": "avenue", "av": "avenue", "rd": "road", "blvd": "boulevard",
    "dr": "drive", "ln": "lane", "ct": "court", "pl": "place", "sq": "square", "hwy": "highway", "pkwy": "parkway",
}


def _address_tokens(text):
    return [STREET_ABBREVIATIONS.get(token, token) for token in re.findall(r"[^\W_]+", search_fold(text))]


def address_mismatch_reason(query, raw):
    """Why one precise geocoder match may still not be the place the user meant.

    Apple's geocoder returns its single best guess even for a street it did not
    find ("Main Street 1" came back as Rykneld Court in England) or for a street
    name found in thousands of towns ("Via Roma 1"). Returns "street_mismatch"
    when the match names no street or place the user typed, "no_town" when the
    query gives nothing beyond the street and house number, or None.
    """
    query_tokens = _address_tokens(query)
    available = Counter(query_tokens)
    named = None
    for field in (raw.get("thoroughfare"), *(raw.get("areasOfInterest") or []), raw.get("name")):
        tokens = Counter(token for token in _address_tokens(field or "") if not token[0].isdigit())
        if tokens and not tokens - available:
            named = tokens
            break
    if named is None:
        return "street_mismatch"
    postal = re.sub(r"\s+", "", search_fold(raw.get("postalCode") or ""))
    if postal and postal in re.sub(r"\s+", "", search_fold(query)):
        return None
    leftover = [token for token in (available - named).elements() if not token[0].isdigit()]
    return None if leftover else "no_town"


def lookup_location(query, *, timeout=GEOCODE_TIMEOUT_SECONDS):
    """Geocode an address through remctl-bridge and judge the result.

    Returns {"query", "status", "candidates", "location"?}. status is
    "resolved" (one precise match that names the street or place typed, in a
    town or postal code the query gives), "ambiguous" (several matches),
    "imprecise" (one match that covers a whole area), "unconfirmed" (one
    match RemCTL cannot tie to the query; "reason" says why), or "not_found".
    Lookup failures return {"error": {code, message}} instead. Nothing is
    written in any case.
    """
    query = str(query or "").strip()
    if not query:
        return {"error": {"code": "location_address_required", "message": "Pass an address to look up."}}
    if len(query) > 512:
        return {"error": {"code": "location_address_too_long", "message": "Addresses are limited to 512 characters."}}
    if is_personal_place_label(query):
        return {"error": {
            "code": "location_label_not_address",
            "message": (
                f"{query!r} names a place only you know, so RemCTL will not guess its address. "
                "Pass the street address or coordinates, and use --location-title to label it."
            ),
        }}
    if not bridge_available():
        return {"error": {"code": "location_lookup_unavailable", "message": "remctl-bridge is required to look up addresses."}}
    result = bridge_call_result({"action": "geocode", "address": query, "timeoutSeconds": timeout}, timeout=timeout + 5)
    payload = result.get("payload") if isinstance(result, dict) else None
    if not bridge_result_ok(result, "ok") or not isinstance(payload, dict):
        code = payload.get("code") if isinstance(payload, dict) else None
        status = payload.get("status") if isinstance(payload, dict) else None
        if code == "timeout" or status == "timeout":
            error_code = "location_lookup_timeout"
        elif code == "denied":
            error_code = "location_lookup_denied"
        else:
            error_code = "location_lookup_failed"
        return {"error": {"code": error_code, "message": bridge_failure_message(result)}}
    raws, candidates = [], []
    for raw in payload.get("candidates") or []:
        try:
            candidates.append(geocoded_candidate(raw))
            raws.append(raw)
        except (KeyError, TypeError, ValueError):
            continue
    lookup = {"query": query, "candidates": candidates[:5]}
    if not candidates:
        lookup["status"] = "not_found"
    elif len(candidates) > 1:
        lookup["status"] = "ambiguous"
    elif candidates[0]["precision"] == "area":
        lookup["status"] = "imprecise"
    elif reason := address_mismatch_reason(query, raws[0]):
        lookup["status"] = "unconfirmed"
        lookup["reason"] = reason
    else:
        lookup["status"] = "resolved"
        lookup["location"] = candidates[0]
    return lookup


LOCATION_LOOKUP_MESSAGES = {
    "not_found": "No place matches {query!r}. Check the address, or pass --latitude and --longitude.",
    "ambiguous": "{query!r} matches {count} places. Pass a fuller address, or the coordinates of the right one.",
    "imprecise": (
        "{query!r} only matches a whole area ({label}), not a spot a location alarm can use. "
        "Pass a street address, or pass its coordinates if the area is really what you want."
    ),
    "street_mismatch": (
        "{query!r} came back as {label}, which is not the street or place you typed. "
        "Check the address, or pass --latitude and --longitude."
    ),
    "no_town": (
        "{query!r} names a street but no town, and many towns have one; Apple's geocoder picked {label}. "
        "Add the town or postal code, or pass --latitude and --longitude."
    ),
}


def location_lookup_message(lookup):
    candidates = lookup["candidates"]
    label = (candidates[0].get("address") or candidates[0].get("name")) if candidates else ""
    template = LOCATION_LOOKUP_MESSAGES[lookup.get("reason") or lookup["status"]]
    return template.format(query=lookup["query"], count=len(candidates), label=label)


def resolve_location_address_or_die(a):
    """Turn --location-address into coordinates before anything is written.

    Sets a.latitude, a.longitude, a default a.location_title, and
    a.resolved_location for the result. Any status but "resolved" stops the
    command, so no reminder is created or changed.
    """
    query = getattr(a, "location_address", None)
    if query is None:
        return None
    lookup = lookup_location(query)
    if "error" in lookup:
        fail_location(a, lookup["error"]["code"], lookup["error"]["message"])
    if lookup["status"] != "resolved":
        extra = {"reason": lookup["reason"]} if lookup.get("reason") else {}
        fail_location(
            a, f"location_{lookup['status']}", location_lookup_message(lookup),
            query=lookup["query"], candidates=lookup["candidates"], **extra,
        )
    location = lookup["location"]
    a.latitude = location["latitude"]
    a.longitude = location["longitude"]
    if not getattr(a, "location_title", None):
        a.location_title = location.get("name") or location.get("address") or lookup["query"]
    a.resolved_location = {
        "query": lookup["query"],
        "title": a.location_title,
        "address": location.get("address"),
        "latitude": location["latitude"],
        "longitude": location["longitude"],
        "precision": location["precision"],
        "radius": getattr(a, "radius", None) or 100,
        "proximity": getattr(a, "proximity", None) or "arriving",
        "source": "geocoded",
    }
    return a.resolved_location


def cmd_location_lookup(a):
    """Show what an address resolves to, without writing anything."""
    timeout = getattr(a, "timeout", None) or GEOCODE_TIMEOUT_SECONDS
    if not 1 <= timeout <= 30:
        print("Error: --timeout must be between 1 and 30 seconds.", file=sys.stderr)
        sys.exit(1)
    lookup = lookup_location(a.query, timeout=timeout)
    if "error" in lookup:
        fail_location(a, lookup["error"]["code"], lookup["error"]["message"])
    lookup["usable"] = lookup["status"] == "resolved"
    if a.json:
        print(json.dumps(lookup, indent=2, ensure_ascii=False))
        return
    if lookup["status"] == "resolved":
        location = lookup["location"]
        print(f"Resolved: {safe_display(location.get('address') or location.get('name') or '')}")
        print(f"Coordinates: {location['latitude']:.6f}, {location['longitude']:.6f} ({location['precision']})")
        return
    print(location_lookup_message(lookup))
    for candidate in lookup["candidates"]:
        print(
            f"  {safe_display(candidate.get('address') or candidate.get('name') or '?')} "
            f"({candidate['latitude']:.5f}, {candidate['longitude']:.5f}; {candidate['precision']})"
        )


