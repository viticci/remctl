def deleted_reminders(db, *, json_mode=False):
    """Join Apple's recovery list to local numeric IDs, preserving parent/subtask groups."""
    require_private_helper(json_mode=json_mode, minimum_protocol=RECOVERY_PRIVATE_PROTOCOL_VERSION)
    result = private_call({"action": "recently_deleted"})
    if result.get("status") != "ok" or not isinstance(result.get("reminders"), list):
        recovery_error("recently_deleted_unavailable", result.get("message") or "Recently Deleted query failed.", json_mode=json_mode)
    native = result["reminders"]
    identifiers = []

    def collect(items, depth=0):
        if depth > 32 or not isinstance(items, list):
            recovery_error("recently_deleted_unavailable", "Unexpected Recently Deleted hierarchy.", json_mode=json_mode)
        for item in items:
            try:
                identifier = str(uuid.UUID(item["objectID"]["uuid"])).lower()
            except (KeyError, TypeError, ValueError, AttributeError):
                recovery_error("recently_deleted_unavailable", "Unexpected Recently Deleted identifier.", json_mode=json_mode)
            identifiers.append(identifier)
            collect(item.get("subtasks", []), depth + 1)
    collect(native)
    rows = {}
    for start in range(0, len(identifiers), 400):
        batch = identifiers[start:start + 400]
        placeholders = ",".join("?" for _ in batch)
        for row in db.execute(
            f"SELECT {rem_cols(db)} FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l ON r.ZLIST = l.Z_PK "
            f"WHERE lower(r.ZCKIDENTIFIER) IN ({placeholders}) AND r.ZMARKEDFORDELETION = 1 AND r.ZACCOUNT IS NOT NULL", batch
        ):
            rows[row["ZCKIDENTIFIER"].lower()] = row

    def convert(item, restore_id=None):
        row = rows.get(item["objectID"]["uuid"].lower())
        if row is None:
            recovery_error("recently_deleted_changed", "Recently Deleted changed while reading. Refresh the list before restoring.", json_mode=json_mode)
        payload = to_dict(row)
        payload.update(deleted=True, recoverable=True, restoreId=restore_id or row["Z_PK"])
        children = [convert(child, payload["restoreId"]) for child in item.get("subtasks", [])]
        payload["subtaskCount"] = len(children)
        if children:
            payload["subtasks"] = children
        return payload
    return [convert(item) for item in native]


def find_deleted_reminder(items, reminder_id):
    for item in items:
        if item["id"] == reminder_id:
            return item
        found = find_deleted_reminder(item.get("subtasks", []), reminder_id)
        if found:
            return found
    return None

def cmd_deleted(a):
    limit, offset, _ = search_page_args(a)
    items = deleted_reminders(open_db(), json_mode=a.json)
    page = items[offset:offset + limit]
    next_offset = offset + len(page) if offset + len(page) < len(items) else None
    if a.json:
        print(json.dumps({"items": page, "count": len(page), "total": len(items), "offset": offset,
                          "limit": limit, "hasMore": next_offset is not None, "nextOffset": next_offset}, indent=2))
    else:
        if not page:
            print("No recently deleted reminders")
        for item in page:
            print(f"  #{item['id']} {safe_display(item['title'])}" + (f" ({item['subtaskCount']} subtasks)" if item['subtaskCount'] else ""))
        if next_offset is not None:
            print(f"More results: remctl deleted --offset {next_offset} --limit {limit}")


def cmd_restore(a):
    require_private_metadata(a, json_mode=a.json, minimum_protocol=RECOVERY_PRIVATE_PROTOCOL_VERSION)
    db = open_db()
    target = resolve_required_list_target_or_die(db, name=a.list, list_id=a.list_id, json_mode=a.json)
    active = q_reminder(db, a.id)
    if active:
        if active["ZLIST"] != target["id"]:
            recovery_error("reminder_not_deleted", "Reminder is already active in another list; restore does not move active reminders.", json_mode=a.json)
        payload = {"status": "already_restored", "id": a.id, "list": target["title"]}
    else:
        item = find_deleted_reminder(deleted_reminders(db, json_mode=a.json), a.id)
        if not item:
            recovery_error("reminder_not_recoverable", f"#{a.id} is not in Recently Deleted.", json_mode=a.json)
        if item["restoreId"] != a.id:
            recovery_error("restore_parent_required", f"Restore parent #{item['restoreId']} to recover this subtask with its hierarchy.", json_mode=a.json)
        identifier = item["deepLink"].rsplit("/", 1)[-1]
        result = private_call({"action": "restore_reminder", "reminderId": identifier, "listId": target["objectUUID"]})
        def restored_tree_matches(current_db, node, parent_id=None):
            row = q_reminder(current_db, node["id"])
            if (not row or row["ZLIST"] != target["id"]
                    or row["ZCKIDENTIFIER"].lower() != node["deepLink"].rsplit("/", 1)[-1].lower()
                    or (row["ZPARENTREMINDER"] or None) != parent_id):
                return False
            return all(restored_tree_matches(current_db, child, node["id"]) for child in node.get("subtasks", []))

        verified = False
        for attempt in range(15):
            verified = _read_fresh_db_value(lambda current_db: restored_tree_matches(current_db, item))
            if verified:
                break
            time.sleep(0.2)
        if not verified:
            recovery_error("restore_unconfirmed", (result.get("message") or "Could not verify recovery of the reminder and all its subtasks.") + " Check info and deleted before retrying.", json_mode=a.json)
        payload = {"status": "restored", "id": a.id, "title": item["title"], "list": target["title"], "verified": True}
    if a.json:
        print(json.dumps(payload))
    else:
        print(f"{payload['status'].replace('_', ' ').capitalize()}: #{a.id} in {safe_display(target['title'])}")


def cmd_delete(a):
    if getattr(a, "batch", False) or len(requested_reminder_ids(a)) > 1:
        run_reminder_state_batch(a, "delete")
        return
    db = open_db()
    r = q_reminder(db, a.id)
