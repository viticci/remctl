MCP_CLIENT_LABELS = {
    "claude-code": "Claude Code",
    "codex": "Codex",
    "claude-desktop": "Claude Desktop and Cowork",
    "tailscale": "Your other devices (Tailscale)",
    "other": "Other MCP clients",
}


def mcp_cli_path():
    """The script every MCP client should launch: this file, symlinks resolved."""
    return Path(__file__).resolve()


def mcp_asset_path(name):
    script_dir = Path(__file__).resolve().parent
    for candidate in (script_dir / name, script_dir / "assets" / name):
        if candidate.is_file():
            return candidate
    return None


# Why a registered MCP connection is not current, as remctl_mcp.registration_status reports it.
MCP_STALE_REASONS = {
    "different_cli": "points at a different RemCTL path",
    "interpreter_missing": "starts a Python that no longer exists",
    "interpreter_versioned": "starts a versioned Homebrew Python that `brew upgrade` deletes",
}


def mcp_stale_reason(client):
    return MCP_STALE_REASONS.get(client.get("staleReason"), MCP_STALE_REASONS["different_cli"])


def mcp_stale_clients_text(stale):
    """One doctor sentence per reason, naming the apps that reason applies to."""
    groups = {}
    for client in stale:
        groups.setdefault(mcp_stale_reason(client), []).append(client["name"])
    return "; ".join(f"MCP connection {reason}: {', '.join(names)}" for reason, names in groups.items())


def mcp_overview(cli_path=None):
    """Detected clients plus their current RemCTL registration, for JSON and doctor."""
    import remctl_mcp

    cli_path = cli_path or mcp_cli_path()
    status = {entry["client"]: entry for entry in remctl_mcp.registration_status(cli_path)}
    clients = []
    for client in remctl_mcp.detect_clients():
        entry = status.get(client["id"], {})
        clients.append({
            **client,
            "configured": bool(entry.get("configured")),
            "current": entry.get("current"),
            "staleReason": entry.get("staleReason"),
            "configPath": entry.get("path"),
        })
    command, args = remctl_mcp.server_command(cli_path)
    return {"server": {"command": [command, *args]}, "clients": clients, "tailscale": remctl_mcp.tailscale_overview()}


def mcp_install_client(client, cli_path, *, scope="user", port=None):
    import remctl_mcp

    if client == "claude-code":
        return remctl_mcp.install_claude_code(cli_path, scope=scope)
    if client == "codex":
        return remctl_mcp.install_codex(cli_path)
    if client == "claude-desktop":
        return remctl_mcp.install_claude_desktop(cli_path)
    if client == "other":
        return {"client": "other", "ok": True, "snippets": remctl_mcp.config_snippets(cli_path)}
    if client == "tailscale":
        return remctl_mcp.install_tailscale(cli_path, port=port)
    raise ValueError(f"unknown MCP client {client!r}")


def mcp_remove_client(client, *, scope="user"):
    import remctl_mcp

    if client == "claude-code":
        return remctl_mcp.remove_claude_code(scope=scope)
    if client == "codex":
        return remctl_mcp.remove_codex()
    if client == "claude-desktop":
        return remctl_mcp.remove_claude_desktop()
    if client == "tailscale":
        return remctl_mcp.remove_tailscale()
    return {"client": client, "ok": True, "note": "Nothing to remove for this client."}


