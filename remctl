def launch_full_disk_access_helper(*, wait=False, targets):
    helper = current_permissions_path()
    if not helper.exists() or not os.access(helper, os.X_OK):
        return False
    targets = list(targets)
    if not targets:
        return False
    args = [
        str(helper),
        "--title",
        "RemCTL Full Disk Access",
        "--subtitle",
        "Drag the signed host into System Settings, or use Command-Shift-G and paste its copied path.",
    ]
    for target in targets:
        args.extend(["--target", target["title"], target["path"], target["subtitle"]])
    service_target = shlex.quote(
        f"gui/{os.getuid()}/{remctl_broker.LAUNCH_AGENT_LABEL}"
    )
    cli_command = shlex.quote(str(current_cli_path()))
    repair_command = (
        f"/bin/launchctl kickstart -k {service_target} && "
        f"{cli_command} doctor --for-agent"
    )
    args.extend(["--after", "Restart Host + Run Doctor", repair_command])
    try:
        if wait:
            return subprocess.run(args).returncode == 0
        subprocess.Popen(args, start_new_session=True)
        return True
    except OSError:
        return False


