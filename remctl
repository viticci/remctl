            passed_match_flags.append("--match")
        if getattr(a, "tag_match", None) is not None:
            passed_match_flags.append("--tag-match")
        if getattr(a, "list_match", None) is not None:
            passed_match_flags.append("--list-match")
        flag_list = ", ".join(passed_match_flags)
