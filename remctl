def cmd_import(a):
    try:
        if a.file == "-":
            if sys.stdin.isatty():
                raise ValueError("import - requires piped standard input")
            input_stream = getattr(sys.stdin, "buffer", sys.stdin)
            raw = input_stream.read(8 * 1024 * 1024 + 1)
            if isinstance(raw, str):
                raw = raw.encode("utf-8")
            if len(raw) > 8 * 1024 * 1024:
                raise ValueError("standard input exceeds 8 MiB")
            data = json.loads(raw.decode("utf-8"))
        else:
            filepath = Path(a.file)
            if not filepath.exists():
                print(f"Error: File '{a.file}' not found", file=sys.stderr)
                sys.exit(1)
            with open(filepath) as f:
                data = json.load(f)
    except (json.JSONDecodeError, IOError, UnicodeError, ValueError) as e:
        print(f"Error: Failed to read JSON: {e}", file=sys.stderr)
        sys.exit(1)

    if not isinstance(data, list):
        print("Error: JSON must be an array of reminder objects", file=sys.stderr)
        sys.exit(1)

    # Validate and normalize the complete document before the first write.
    add_args = []
    validation_errors = []
    for index, item in enumerate(data):
        if not isinstance(item, dict):
            validation_errors.append({"index": index, "message": "item must be an object"})
            continue
        title = item.get("title")
        if not isinstance(title, str) or not title.strip():
            validation_errors.append({"index": index, "message": "item requires a non-empty string title"})
            continue
        string_fields = ("list", "notes", "due", "dueDate", "priority", "url", "alarm")
        invalid_field = next(
            (field for field in string_fields if item.get(field) is not None and not isinstance(item.get(field), str)),
            None,
        )
        if invalid_field is not None:
            validation_errors.append({"index": index, "message": f"{invalid_field} must be a string"})
            continue
        due = item.get("due") or item.get("dueDate")
        if due and parse_due(due) is None:
            validation_errors.append({"index": index, "message": f"could not parse due date {due!r}"})
            continue
        recurrence = item.get("recurrence")
        if recurrence is not None and parse_recurrence(recurrence) is None:
            validation_errors.append({"index": index, "message": f"could not parse recurrence {recurrence!r}"})
            continue
        alarm = item.get("alarm")
        if alarm and parse_alarm(alarm) is None:
            validation_errors.append({"index": index, "message": f"could not parse alarm {alarm!r}"})
            continue
        priority = item.get("priority")
        if priority and priority.lower() not in {"high", "h", "medium", "med", "m", "low", "l", "none"}:
            validation_errors.append({"index": index, "message": "priority must be high, medium, low, or none"})
            continue
        if "flagged" in item and not isinstance(item["flagged"], bool):
            validation_errors.append({"index": index, "message": "flagged must be a boolean"})
            continue
        class AddArgs:
            pass
        aa = AddArgs()
        aa.title = title
        aa.list = item.get("list")
        aa.notes = item.get("notes")
        aa.due = due
        aa.priority = item.get("priority")
        aa.flag = item.get("flagged", False)
        aa.tags = None
        aa.url = item.get("url")
        aa.recurrence = recurrence
        aa.alarm = alarm
        aa.json = True
        add_args.append(aa)

    if validation_errors:
        payload = {
            "status": "error",
            "code": "invalid_import",
            "message": "Import validation failed; no reminders were created.",
            "created": 0,
            "createdIds": [],
            "errors": validation_errors,
            "total": len(data),
        }
        if getattr(a, "json", False):
            print(json.dumps(payload, ensure_ascii=False), file=sys.stderr)
        else:
            print(f"Error: {payload['message']}", file=sys.stderr)
            for error in validation_errors:
                print(f"  Item {error['index']}: {error['message']}", file=sys.stderr)
        sys.exit(1)

    created_ids = []
    created = 0
    errors = []
    for index, aa in enumerate(add_args):
        stdout = io.StringIO()
        stderr = io.StringIO()
        try:
            with contextlib.redirect_stdout(stdout), contextlib.redirect_stderr(stderr):
                cmd_add(aa)
            result = json.loads(stdout.getvalue())
            created += 1
            created_id = result.get("numericId") or result.get("id")
            if created_id is not None:
                created_ids.append(created_id)
            if getattr(a, "json", False):
                ident = created_id if created_id is not None else "unknown"
                progress_id = safe_display(str(ident))[:128]
                print(f"imported index={index} id={progress_id}", file=sys.stderr, flush=True)
            if not getattr(a, "json", False):
                print(f"Created: {safe_display(aa.title)}")
        except (SystemExit, json.JSONDecodeError) as exc:
            message = stderr.getvalue().strip() or stdout.getvalue().strip() or str(exc)
            errors.append({"index": index, "title": aa.title, "message": message})
            if not getattr(a, "json", False):
                print(f"Error: Failed to import {safe_display(aa.title)}: {message}", file=sys.stderr)

    summary = {
        "status": "completed" if not errors else "partial",
        "created": created,
        "createdIds": created_ids,
        "errors": errors,
        "total": len(data),
    }
    if getattr(a, 'json', False):
        print(json.dumps(summary, ensure_ascii=False))
    else:
        print(f"\nImported {created}/{len(data)} reminders ({len(errors)} errors)")
    if errors:
        sys.exit(1)

def add_smart_list_filter_arguments(parser, *, match_default="all", tag_match_default="any"):
    parser.add_argument("--match", choices=["all", "any"], default=match_default, help="Match all or any supplied filters")
    parser.add_argument("--filter-json", help="Advanced: raw official smart-list filter JSON or @path")
    parser.add_argument("--flagged", action="store_true", help="Filter to flagged reminders")
    parser.add_argument("--priority", help="Priority filter: high, medium, low, or comma-separated values")
    parser.add_argument("--tags", help="Selected tag filter, comma-separated; # prefix optional")
    parser.add_argument("--tag-match", choices=["all", "any"], default=tag_match_default, help="Selected tag matching mode")
    parser.add_argument("--any-tag", action="store_true", help="Filter to reminders with any tag")
    parser.add_argument("--untagged", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--date", choices=["any", "today"], help="Date filter")
    parser.add_argument("--date-today-include-past-due", action="store_true", help="Include past due reminders with --date today")
    parser.add_argument("--date-on", help="Date filter: on YYYY-MM-DD")
    parser.add_argument("--date-before", help="Date filter: before YYYY-MM-DD")
    parser.add_argument("--date-after", help="Date filter: after YYYY-MM-DD")
    parser.add_argument("--date-range", help="Date filter range: START,END")
    parser.add_argument("--date-relative", help=argparse.SUPPRESS)
    parser.add_argument("--time", choices=["morning", "afternoon", "evening", "night"], help="Time-of-day filter")
    parser.add_argument("--include-list", action="append", help="Include reminders from one list name")
    parser.add_argument("--exclude-list", action="append", help=argparse.SUPPRESS)
    parser.add_argument("--include-list-id", action="append", type=int, help="Include reminders from one numeric list ID")
    parser.add_argument("--exclude-list-id", action="append", type=int, help=argparse.SUPPRESS)
    parser.add_argument("--list-match", choices=["all", "any"], help=argparse.SUPPRESS)
    parser.add_argument("--vehicle", choices=["connected"], help="Location vehicle filter")
