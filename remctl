        print_reminder_table(items, db, args=a)
        return
    if not items:
        print(f"Nothing due in the next {days} days")
        return
    print(C.bold(f"Upcoming ({days} days):"))
    # Group by day
    groups = {}
    for i in items:
        dt = ts(row_shown_date(i))
        day_key = dt.strftime("%Y-%m-%d")
        day_label = dt.strftime("%A, %b %d")
        today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
        if dt.date() == today.date():
            day_label = "Today"
        elif dt.date() == (today + timedelta(days=1)).date():
            day_label = "Tomorrow"
        groups.setdefault((day_key, day_label), []).append(i)
    for (day_key, day_label), day_items in sorted(groups.items()):
        print(f"\n  {C.bold(day_label)}:")
        img = _image_render_config_verbose(a)
        for i in day_items:
            print(fmt(i, db, indent="    ", _sc=sc, _ht=ht, _img=img, _ind=ind))
