def fail_private_add_partial(partial_context, failed_action, error_message):
    if partial_context.get("json"):
        payload = {
            "status": "partial",
            "id": partial_context.get("id", ""),
            "failed": failed_action,
            "error": error_message,
        }
        numeric_id = partial_context.get("numericId")
        if numeric_id is not None:
            payload["numericId"] = numeric_id
        completed = partial_context.get("completed")
        if completed:
            payload["completed"] = completed
        print(json.dumps(payload))
    else:
        numeric_id = partial_context.get("numericId")
        if numeric_id is not None:
            ident = f"#{numeric_id}"
        else:
            ident = partial_context.get("id") or "(unknown)"
        print(
            f"Created reminder {ident} but failed to apply {failed_action}; "
            "re-run edit to finish. Do NOT re-run add (would duplicate).",
            file=sys.stderr,
        )
        print(f"Error: {error_message}", file=sys.stderr)
    sys.exit(1)


def private_action(data, partial_context=None):
    attempts = 3 if data.get("action") in IDEMPOTENT_PRIVATE_ACTIONS else 1
    result = None
    for attempt in range(attempts):
        result = private_call(data)
        if result and result.get("status") == "updated":
            if partial_context is not None:
                partial_context.setdefault("completed", []).append(data.get("action", "private_action"))
            return result
        if not private_helper_error_is_transient(result) or attempt == attempts - 1:
            break
        time.sleep(0.5)
    if not result or result.get("status") != "updated":
        message = result.get("message") if isinstance(result, dict) else "private helper failed"
        if partial_context is not None:
            fail_private_add_partial(partial_context, data.get("action", "private_action"), message)
        print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)
    return result


def subtask_rows_for_parent_move(db, reminder):
    try:
        parent_pk = reminder["Z_PK"]
    except (KeyError, TypeError):
        return []
    try:
        return list(q_subtasks_for_parent(db, parent_pk))
    except (AttributeError, sqlite3.Error, TypeError, ValueError):
        return []


def wait_for_cloned_reminder_tree(reminder_ckid, target_list_pk, expected_subtasks, attempts=24, delay=0.25):
    for _ in range(attempts):
        db = open_db()
        row = q_reminder_by_identifier(db, reminder_ckid)
        if row and row["ZLIST"] == target_list_pk:
            subtasks = q_subtasks_for_parent(db, row["Z_PK"], limit=max(500, expected_subtasks + 5))
            if len(subtasks) == expected_subtasks:
                return row, subtasks
        time.sleep(delay)
    return None, []


def delete_reminder_by_identifier_or_die(reminder):
    reminder_ckid = _row_get(reminder, "ZCKIDENTIFIER")
    if bridge_available() and reminder_ckid:
        result = bridge_call({"action": "delete", "id": reminder_ckid})
        if result and result.get("status") == "deleted":
            return result
    rid = _rem_id(reminder)
    if rid and osa_by_id_try(rid, "delete r"):
        return {"status": "deleted", "fallback": "applescript"}
    title = safe_display(_row_get(reminder, "ZTITLE") or "(untitled)")
    print(
        f"Error: cloned '{title}' into the target list, but failed to delete original #{reminder['Z_PK']}. "
        "Leaving both reminders in place to avoid data loss.",
        file=sys.stderr,
    )
    sys.exit(1)


def clone_reminder_tree_to_list_or_die(db, reminder, target_list_ref, child_rows):
    reminder_ckid = _row_get(reminder, "ZCKIDENTIFIER")
    target_list_ckid = target_list_ref.get("objectUUID")
    if not reminder_ckid:
        print("Error: cannot clone-move reminder because it has no stable ReminderKit identifier.", file=sys.stderr)
        sys.exit(1)
    if not target_list_ckid:
        print("Error: cannot clone-move reminder because the target list has no stable ReminderKit identifier.", file=sys.stderr)
        sys.exit(1)
    if not private_available():
        print(
            f"Error: clone-moving #{reminder['Z_PK']} requires remctl-private. "
            "Reinstall remctl with ./install.sh, then retry.",
            file=sys.stderr,
        )
        sys.exit(1)
    child_ids = [_row_get(child, "ZCKIDENTIFIER") for child in child_rows]
    missing = [child["Z_PK"] for child, child_id in zip(child_rows, child_ids) if not child_id]
    if missing:
        print(
            "Error: cannot move parent with subtasks because these subtasks have no stable ReminderKit identifier: "
            + ", ".join(f"#{item}" for item in missing),
            file=sys.stderr,
        )
        sys.exit(1)
    result = private_call({
        "action": "clone_reminder_tree_to_list",
        "id": reminder_ckid,
        "listId": target_list_ckid,
        "childIds": child_ids,
    })
    if not result or result.get("status") != "cloned":
        message = result.get("message") if isinstance(result, dict) else "private helper failed"
        print(f"Error: failed to clone reminder into target list: {message}", file=sys.stderr)
        sys.exit(1)
    new_ckid = result.get("newId")
    if not new_ckid:
        print("Error: private helper cloned the reminder but did not return the new reminder identifier.", file=sys.stderr)
        sys.exit(1)
    new_row, new_children = wait_for_cloned_reminder_tree(new_ckid, target_list_ref["id"], len(child_rows))
    if not new_row:
        print(
            "Error: cloned reminder tree was not visible in the target list with the expected subtask count. "
            f"Original #{reminder['Z_PK']} was not deleted.",
            file=sys.stderr,
        )
        sys.exit(1)
    delete_result = delete_reminder_by_identifier_or_die(reminder)
    return {
        "status": "updated",
        "id": new_row["Z_PK"],
        "oldId": reminder["Z_PK"],
        "title": _row_get(new_row, "ZTITLE", _row_get(reminder, "ZTITLE")),
        "list": target_list_ref["title"],
        "objectUUID": new_ckid,
        "subtasksMoved": len(new_children),
        "method": "clone-delete",
        "private": result,
        "delete": delete_result,
    }


