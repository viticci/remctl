def print_group_reminder_tables(group_ref, children, items, db, memberships_by_list, args):
    if not items:
        print(f"No {'active ' if not args.completed else ''}reminders in group '{safe_display(group_ref['title'])}'")
        return
    print(f"{C.bold(color_list_name(group_ref['title'], db))} {C.dim('(group)')}:")
    for child in children:
        child_items = [item for item in items if _row_get(item, "ZLIST") == child["Z_PK"]]
