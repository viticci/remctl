def run_reminder_state_batch(a, operation):
    """Complete, uncomplete, or delete several reminders by numeric id.

    Every id is resolved before the first write, repeats are dropped, and each
    reminder is written at most once. The batch stops at the first write whose
    result is uncertain or whose bridge call timed out, because the next ones
    would likely hit the same stalled bridge, and it starts no write after
    REMINDER_BATCH_BUDGET_SECONDS. Ids it did not reach are reported as
    skipped; they were not changed.
    """
    json_mode = bool(getattr(a, "json", False))
    requested = requested_reminder_ids(a)
    if len(requested) > REMINDER_BATCH_MAX:
        message = f"Pass at most {REMINDER_BATCH_MAX} reminder ids per call; got {len(requested)}. Nothing was changed."
        if json_mode:
            print(json.dumps({"status": "error", "code": "batch_too_large", "message": message}), file=sys.stderr)
        else:
            print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)
    unique, duplicates = [], []
    for reminder_id in requested:
        (duplicates if reminder_id in unique else unique).append(reminder_id)
    completion_dt, completion_iso = completion_date_or_die(a) if operation == "done" else (None, None)

    db = open_db()
    success_status = STATE_WRITES[operation][1]
    rows, results, targets = {}, {}, []
    for reminder_id in unique:
        r = q_reminder(db, reminder_id)
        if not r:
            results[reminder_id] = {
                "id": reminder_id, "status": "not_found", "code": "reminder_not_found",
                "message": f"#{reminder_id} not found",
            }
            continue
        rows[reminder_id] = r
        if operation == "done" and completion_iso and _row_get(r, "recurrence_frequency") is not None:
            results[reminder_id] = {
                "id": reminder_id, "status": "error", "code": "completion_date_unsupported_for_recurring",
                "message": "--date is not supported for recurring reminders; complete it without --date to advance the series.",
            }
            continue
        targets.append(reminder_id)

    if operation == "delete" and targets:
        lines = "\n".join(
            f"  #{reminder_id} '{safe_display(rows[reminder_id]['ZTITLE'])}' ({safe_display(rows[reminder_id]['list_name'])})"
            for reminder_id in targets
        )
        noun = "reminder" if len(targets) == 1 else "reminders"
        if not confirm_destructive_action(a, f"Delete {len(targets)} {noun}?\n{lines}\n[y/N] ", identifier=targets):
            return

    started = time.monotonic()
    stop = None  # (code, message) once the batch stops starting writes
    for reminder_id in targets:
        r = rows[reminder_id]
        if stop is None and time.monotonic() - started > REMINDER_BATCH_BUDGET_SECONDS:
            stop = ("batch_time_budget", f"Not attempted: the batch ran past {REMINDER_BATCH_BUDGET_SECONDS} seconds; nothing was changed.")
        if stop is not None:
            results[reminder_id] = {"id": reminder_id, "status": "skipped", "code": stop[0], "message": stop[1]}
            continue
        outcome = write_reminder_state(r, operation, completion_dt=completion_dt, completion_iso=completion_iso)
        if outcome["outcome"] == "ok":
            item = {"id": reminder_id, "status": success_status}
            if completion_iso:
                item["completionDate"] = completion_iso
        elif outcome["outcome"] == "uncertain":
            item = {"id": reminder_id, "status": "uncertain", "code": outcome["code"], "message": outcome["message"]}
        elif operation == "delete" and q_reminder(db, reminder_id) is None:
            # Gone anyway, for example removed with a parent deleted earlier in this batch.
            item = {"id": reminder_id, "status": success_status}
        else:
            item = {
                "id": reminder_id, "status": "error", "code": outcome["code"],
                "message": f"{outcome['reason']}; #{reminder_id} was not changed.",
            }
        results[reminder_id] = item
        if item["status"] == "uncertain" or outcome.get("stalled"):
            stop = ("batch_stopped", f"Not attempted after the stalled or uncertain write for #{reminder_id}; nothing was changed.")

    items = []
    for reminder_id in unique:
        item = results[reminder_id]
        r = rows.get(reminder_id)
        if r is not None:
            item["title"] = r["ZTITLE"]
            item["list"] = _row_get(r, "list_name")
            if operation == "done" and _row_get(r, "recurrence_frequency") is not None:
                item["recurring"] = True
        items.append(item)
    succeeded = [item["id"] for item in items if item["status"] == success_status]
    uncertain = [item["id"] for item in items if item["status"] == "uncertain"]
    failed = [item["id"] for item in items if item["id"] not in succeeded and item["id"] not in uncertain]
    # "failed" promises that nothing changed; anything that may have changed is "partial".
    status = success_status if len(succeeded) == len(items) else ("partial" if succeeded or uncertain else "failed")
    payload = {
        "status": status,
        "operation": operation,
        "requested": requested,
        "succeeded": succeeded,
        "failed": failed,
        "uncertain": uncertain,
        "results": items,
    }
    if duplicates:
        payload["duplicatesIgnored"] = duplicates
    if json_mode:
        print(json.dumps(payload))
    else:
        verb = {"done": "Completed", "undone": "Uncompleted", "delete": "Deleted"}[operation]
        for item in items:
            if item["status"] == success_status:
                print(f"{verb}: #{item['id']} {safe_display(item.get('title') or '')}")
            else:
                print(f"Error: {item['message']}", file=sys.stderr)
        if duplicates:
            print(f"Ignored repeated ids: {', '.join(str(i) for i in duplicates)}")
        print(f"{len(succeeded)} of {len(items)} {verb.lower()}")
    if status != success_status:
        sys.exit(1)

def cmd_edit(a):
    refuse_private_args_without_opt_in(a)
    if getattr(a, "tags", None) and not private_metadata_enabled(a):
        print("Error: editing synced tags requires --private.", file=sys.stderr)
        sys.exit(1)
    db = open_db()
    r = q_reminder(db, a.id)
    if not r:
        print(f"Error: #{a.id} not found", file=sys.stderr)
        sys.exit(1)
    # The title every --json result echoes: the new one when the edit renames the
    # reminder, otherwise the title it keeps. Matches add/done/undone/delete, which
    # all echo `title` so a caller never has to re-read the reminder to label it.
    resulting_title = a.title if getattr(a, "title", None) else _row_get(r, "ZTITLE")
    target_list_ref = None
    target_list_name = getattr(a, "list", None)
    target_list_id = getattr(a, "list_id", None)
    target_list_pk = r["ZLIST"]
    if target_list_name or target_list_id is not None:
        target_list_ref = resolve_required_list_target_or_die(
            db,
            name=target_list_name,
            list_id=target_list_id,
        )
        target_list_name = target_list_ref["title"]
        target_list_pk = target_list_ref["id"]
    wants_private = private_metadata_enabled(a) and private_changes_from_args(a)
    if wants_private:
        require_private_metadata(a)
        validate_private_args(a)
        if getattr(a, "grocery", False):
            require_grocery_list_target(db, target_list_pk)
        if subtask_specs_need_bridge(parse_subtask_specs(getattr(a, "subtask", None))) and not bridge_available():
            print("Error: rich private subtasks require remctl-bridge for notes, due dates, priority, recurrence, or alarms.", file=sys.stderr)
            sys.exit(1)

    pm = {"high": 1, "medium": 5, "low": 9, "none": 0}
    priority_value = None
    if a.priority:
        priority_value = pm.get(a.priority.lower())
        if priority_value is None:
            print("Error: priority must be high, medium, low, or none.", file=sys.stderr)
            sys.exit(1)
    parsed_recurrence = None
    if hasattr(a, 'recurrence') and a.recurrence:
        parsed_recurrence = recurrence_or_die(a.recurrence)

    # Parse due date exactly once, up front. Warn loudly if an unparseable
    # string was given so the user doesn't silently get a no-op write that
    # falls through to the broken bridge path.
    dt = None
    if a.due and a.due != "clear":
        dt = parse_due(a.due)
        if dt is None:
            fail_invalid_due_date(a.due, json_mode=getattr(a, "json", False))
    due_all_day = bool(dt and due_spec_is_all_day(a.due))
    if early_reminder_requires_due_date(a) and a.due == "clear":
        fail_early_reminder_without_due(json_mode=getattr(a, "json", False))
    if early_reminder_requires_due_date(a) and dt is None and not r["ZDUEDATE"]:
        fail_early_reminder_without_due(json_mode=getattr(a, "json", False))
    if a.due == "clear" and _row_get(r, "recurrence_frequency") is not None:
        fail_repeating_reminder_needs_due(a.id, json_mode=getattr(a, "json", False))
    parsed_alarm = None
    clear_alarm = False
    if getattr(a, "alarm", None):
        clear_alarm = alarm_clear_requested(a.alarm)
        if not clear_alarm:
            parsed_alarm = parse_alarm(a.alarm)
            if parsed_alarm is None:
                print(f"Error: could not parse alarm {a.alarm!r}. Use 15m, 1h, 1d, an absolute date, or clear.", file=sys.stderr)
                sys.exit(1)
    if alarm_is_relative(parsed_alarm) and (a.due == "clear" or (dt is None and not r["ZDUEDATE"])):
        fail_relative_alarm_without_due(json_mode=getattr(a, "json", False))
    if wants_private:
        # Last check before the first write: a failed lookup changes nothing.
        resolve_location_address_or_die(a)

    # An omitted --notes preserves the current body; an explicit value replaces it.
    # Compute once so a bridge failure cannot append the URL twice on fallback.
    notes_body = a.notes
    if getattr(a, "url", None) and not wants_private:
        if notes_body is None:
            notes_body = _row_get(r, "ZNOTES")
        notes_body = (notes_body + "\n\n" + a.url) if notes_body else a.url

    # Auto double-tap: if Reminders' displayed due date already equals the
    # requested target, AppleScript treats it as a no-op and pushes only
    # lastModifiedDate. Force a real value change by setting an intermediate
    # date first (bumped 1 hour), then the real target.
    dt_nudge = None
    if dt is not None and r["ZDUEDATE"] is not None:
        current = ts(r["ZDUEDATE"])
        if current and int(current.timestamp()) == int(dt.timestamp()):
            dt_nudge = dt + (timedelta(days=1) if due_all_day else timedelta(hours=1))
    carry_absolute_alarm = should_carry_absolute_alarm_to_new_due(
        db,
        r,
        dt,
        explicit_alarm=bool(getattr(a, "alarm", None)),
    )
    clear_matching_absolute_alarm = (
        a.due == "clear"
        and not clear_alarm
        and should_clear_matching_absolute_alarm(db, r)
    )

    moving_to_different_list = bool(target_list_ref and target_list_pk != r["ZLIST"])
    child_rows_for_move = []
    has_other_changes_for_move = bool(
        a.title
        or a.notes is not None
        or a.priority
        or a.due
        or (hasattr(a, 'url') and a.url)
        or parsed_recurrence is not None
        or clear_alarm
        or parsed_alarm
        or wants_private
    )
    if moving_to_different_list:
        child_rows_for_move = subtask_rows_for_parent_move(db, r)
        if child_rows_for_move:
            if has_other_changes_for_move:
                print(
                    "Error: moving a parent reminder with subtasks cannot currently be combined with other edits. "
                    "Move it first, then edit the cloned reminder returned by remctl.",
                    file=sys.stderr,
                )
                sys.exit(1)
            move_result = clone_reminder_tree_to_list_or_die(db, r, target_list_ref, child_rows_for_move)
            emit_clone_delete_move_result(a, move_result, target_list_ref)
            return

    # Bridge-first for speed (post-2026-04-17 bridge fix: reminder.timeZone
    # is set explicitly and .timeZone is no longer embedded in the
    # dueDateComponents set, so CloudKit now receives the new due date). If
    # the bridge is unavailable, we fall back to AppleScript via Reminders.app.
    #
    # Double-tap defense: if the displayed date already equals the new target,
    # fire an intermediate update first so the CKRecord is forced to carry a
    # real dueDateComponents change.
    bridge_write_result = None
    bridge_write_attempted = False
    nudge_succeeded = False
    if bridge_available() and r["ZCKIDENTIFIER"]:
        if dt_nudge is not None:
            nudge_data = {
                "action": "update",
                "id": r["ZCKIDENTIFIER"],
                "due": dt_nudge.isoformat(),
            }
            if due_all_day:
                nudge_data["allDay"] = True
            nudge_result = bridge_call_result(nudge_data)
            if bridge_failure_is_access_error(nudge_result):
                fail_bridge_write(nudge_result, operation="prepare the reminder edit")
            elif bridge_result_ok(nudge_result, "updated"):
                nudge_succeeded = True
            else:
                print(NUDGE_PREP_WARNING, file=sys.stderr)
        data = {"action": "update", "id": r["ZCKIDENTIFIER"]}
        has_changes = False
        if a.title: data["title"] = a.title; has_changes = True
        if target_list_ref:
            data.update(bridge_list_target_payload(target_list_ref))
            has_changes = True
        if notes_body is not None:
            data["notes"] = notes_body
            has_changes = True
        if priority_value is not None:
            data["priority"] = priority_value; has_changes = True
        if a.due == "clear":
            data["due"] = None; has_changes = True
            if clear_matching_absolute_alarm:
                data["clearAlarms"] = True
        elif dt is not None:
            data["due"] = dt.isoformat(); has_changes = True
            if due_all_day:
                data["allDay"] = True
        if parsed_recurrence is not None:
            data["recurrence"] = parsed_recurrence; has_changes = True
        if clear_alarm:
            data["clearAlarms"] = True; has_changes = True
        elif parsed_alarm:
            data["alarm"] = parsed_alarm; has_changes = True
        elif carry_absolute_alarm:
            data["alarm"] = dt.isoformat(); has_changes = True
        if has_changes:
            bridge_write_attempted = True
            bridge_write_result = bridge_call_result(data)
            if bridge_result_ok(bridge_write_result, "updated"):
                result = bridge_write_result["payload"]
                private_results = apply_private_changes(
                    r["ZCKIDENTIFIER"],
                    a,
                    db=db,
                    list_pk=target_list_pk,
                ) if wants_private else []
                if a.json:
                    payload = {"status": "updated", "id": a.id, "title": resulting_title}
                    if target_list_ref:
                        payload["list"] = target_list_name
                        if target_list_ref.get("method") != "exact":
                            payload["resolvedList"] = {
                                "requested": target_list_ref.get("requested"),
                                "title": target_list_ref["title"],
                                "id": target_list_ref["id"],
                                "method": target_list_ref["method"],
                            }
                    if private_results:
                        payload["private"] = private_results
                    print(json.dumps(payload))
                else:
                    print(f"Updated #{a.id}")
                    if target_list_ref:
                        print(f"List: {safe_display(target_list_name)}")
                    if private_results:
                        print(f"Private metadata: applied {len(private_results)} update{'s' if len(private_results) != 1 else ''}")
                return
            if bridge_failure_is_access_error(bridge_write_result):
                warn_if_nudged_due_stranded(r, nudge_succeeded, dt, due_all_day)
                fail_bridge_write(bridge_write_result, operation="edit the reminder")
            if (
                moving_to_different_list
                and not child_rows_for_move
                and not has_other_changes_for_move
                and bridge_failure_allows_clone_delete_fallback(bridge_write_result)
            ):
                move_result = clone_reminder_tree_to_list_or_die(db, r, target_list_ref, [])
                emit_clone_delete_move_result(a, move_result, target_list_ref)
                return
        elif wants_private:
            private_results = apply_private_changes(
                r["ZCKIDENTIFIER"],
                a,
                db=db,
                list_pk=target_list_pk,
            )
            if a.json:
                print(json.dumps({
                    "status": "updated",
                    "id": a.id,
                    "title": resulting_title,
                    "private": private_results,
                }, indent=2))
            else:
                print(f"Updated #{a.id}")
                print(f"Private metadata: applied {len(private_results)} update{'s' if len(private_results) != 1 else ''}")
            return

    if (
        bridge_write_attempted
        and bridge_write_result
        and bridge_write_result.get("returncode") != 0
        and (
            target_list_ref
            or parsed_recurrence is not None
            or clear_alarm
            or parsed_alarm
            or wants_private
        )
    ):
        warn_if_nudged_due_stranded(r, nudge_succeeded, dt, due_all_day)
        fail_bridge_write(bridge_write_result, operation="edit the reminder")

    if carry_absolute_alarm or clear_matching_absolute_alarm:
        warn_if_nudged_due_stranded(r, nudge_succeeded, dt, due_all_day)
        print("Error: this edit requires remctl-bridge to keep due/display/alarm state aligned.", file=sys.stderr)
        sys.exit(1)
    if dt is not None and due_all_day:
        warn_if_nudged_due_stranded(r, nudge_succeeded, dt, due_all_day)
        print("Error: all-day due date edits require remctl-bridge so Reminders can store date-only components.", file=sys.stderr)
        sys.exit(1)

    # AppleScript fallback for when bridge isn't available.
    has_bridge_only = (
        (hasattr(a, 'recurrence') and a.recurrence) or
        (hasattr(a, 'alarm') and a.alarm) or wants_private
        or target_list_ref
    )
    has_applescript_fields = bool(
        a.title or notes_body is not None or a.due or a.priority
        or (hasattr(a, 'url') and a.url and not wants_private)
    )

    if r["ZCKIDENTIFIER"] and has_applescript_fields and not has_bridge_only:
        parts = []
        # The date goes first: it is the change Reminders can refuse, and
        # AppleScript has no transaction, so a refusal after the other
        # statements would leave them applied.
        if a.due == "clear":
            parts.append("set due date of r to missing value")
        elif dt is not None:
            # Same double-tap defense as the bridge path.
            if dt_nudge is not None:
                parts.append(as_date_assign(dt_nudge))
            parts.append(as_date_assign(dt))
        if a.title:
            parts.append(f'set name of r to "{esc(a.title)}"')
        if notes_body is not None:
            parts.append(f'set body of r to "{esc(notes_body)}"')
        if priority_value is not None:
            parts.append(f"set priority of r to {priority_value}")
        if parts and osa_by_id_try(_rem_id(r), chr(10).join(parts)):
            if a.json:
                print(json.dumps({"status": "updated", "id": a.id, "title": resulting_title}))
            else:
                print(f"Updated #{a.id}")
            return

    if not has_applescript_fields and not has_bridge_only:
        # No-op edit: a real, non-error outcome. Under --json it has to be a
        # structured payload like every other result, not a bare English line
        # that breaks the caller's JSON parse. Exit code stays 0.
        if getattr(a, "json", False):
            print(json.dumps({
                "status": "unchanged",
                "code": "nothing_to_update",
                "id": a.id,
                "title": resulting_title,
                "message": "Nothing to update.",
            }))
        else:
            print("Nothing to update.")
        return
    if not r["ZCKIDENTIFIER"]:
        _refuse_unsafe_title_fallback(r, "edit it", "The reminder has no stable identifier")
    warn_if_nudged_due_stranded(r, nudge_succeeded, dt, due_all_day)
    reason = "Identifier-based writes failed"
    if bridge_write_attempted and bridge_write_result and bridge_write_result.get("returncode") != 0:
        reason += f" (remctl-bridge: {bridge_failure_message(bridge_write_result).rstrip('.')})"
    _refuse_unsafe_title_fallback(r, "edit it", reason)


def reminder_move_relation(a):
    choices = []
    if getattr(a, "before", None) is not None:
        choices.append(("before", a.before))
    if getattr(a, "after", None) is not None:
        choices.append(("after", a.after))
    if getattr(a, "first", False):
        choices.append(("first", None))
    if getattr(a, "last", False):
        choices.append(("last", None))
    if len(choices) != 1:
        print("Error: pass exactly one of --before, --after, --first, or --last.", file=sys.stderr)
        sys.exit(1)
    relation, anchor_id = choices[0]
    if anchor_id == a.id:
        print("Error: a reminder cannot be positioned relative to itself.", file=sys.stderr)
        sys.exit(1)
    return relation, anchor_id


def reorder_identifier_list(ordering, moving_id, relation, anchor_id=None):
    result = [item for item in ordering if item != moving_id]
    if relation in {"before", "after"}:
        if anchor_id not in result:
            raise ValueError("anchor_missing")
        index = result.index(anchor_id) + (1 if relation == "after" else 0)
    else:
        if relation == "first":
            index = 0
        elif relation == "last":
            index = len(result)
        else:
            raise ValueError("invalid_relation")
    result.insert(index, moving_id)
    return result


def _wait_for_order(read_order, expected, attempts=12, delay=0.25):
    for _ in range(attempts):
        if read_order() == expected:
            return True
        time.sleep(delay)
    return False


def _read_fresh_db_value(reader):
    db = open_db()
    try:
        return reader(db)
    finally:
        db.close()


def _smart_list_move_request(db, a, reminder, relation, anchor):
    smart_ref = resolve_smart_list_or_die(db, name=a.smart_list, smart_list_id=a.smart_list_id)
    if smart_ref["kind"] != "custom":
        print("Error: reminder positioning currently supports custom smart lists only.", file=sys.stderr)
        sys.exit(1)
    smart_uuid = smart_ref.get("objectUUID")
    hint = q_manual_sort_hint(db, CUSTOM_SMART_LIST_MANUAL_ORDER_TYPE, smart_uuid)
    if hint is None:
        print(
            "Error: this smart list has no manual-order hint yet. Reorder one reminder in Reminders.app once, then retry.",
            file=sys.stderr,
        )
        sys.exit(1)

    sections = q_smart_list_sections(db, smart_ref["id"])
    if sections or hint["secondaryLevelElementIDsByTopLevelElementID"]:
        print(
            "Error: reminder positioning in sectioned custom smart lists is not supported yet.",
            file=sys.stderr,
        )
        sys.exit(1)
    moving_uuid = reminder["ZCKIDENTIFIER"]
    if moving_uuid not in hint["topLevelElementIDs"]:
        print(
            f"Error: #{a.id} has no persisted position in smart list {smart_ref['title']!r}.",
            file=sys.stderr,
        )
        sys.exit(1)

    anchor_uuid = anchor["ZCKIDENTIFIER"] if anchor is not None else None
    try:
        ordered_ids = reorder_identifier_list(
            hint["topLevelElementIDs"],
            moving_uuid,
            relation,
            anchor_uuid,
        )
    except ValueError as exc:
        if str(exc) == "anchor_missing":
            print(
                "Error: the anchor has no persisted manual position in this smart list. "
                "Move the anchor once in Reminders.app or use --first/--last.",
                file=sys.stderr,
            )
            sys.exit(1)
        raise
    return smart_ref, ordered_ids, {
        "action": "set_smart_list_manual_order",
        "id": moving_uuid,
        "smartListId": smart_uuid,
        "manualOrderingId": hint["objectUUID"],
        "listType": hint["listType"],
        "topLevelElementIds": ordered_ids,
        "secondaryLevelElementIdsByTopLevelElementId": hint["secondaryLevelElementIDsByTopLevelElementID"],
    }


def cmd_reminder_move(a):
    require_private_metadata(a)
    relation, anchor_id = reminder_move_relation(a)
    db = open_db()
    reminder = q_reminder(db, a.id)
    if not reminder or not reminder["ZCKIDENTIFIER"]:
        print(f"Error: #{a.id} not found or has no stable identifier.", file=sys.stderr)
        sys.exit(1)
    anchor = q_reminder(db, anchor_id) if anchor_id is not None else None
    if anchor_id is not None and (not anchor or not anchor["ZCKIDENTIFIER"]):
        print(f"Error: anchor #{anchor_id} not found or has no stable identifier.", file=sys.stderr)
        sys.exit(1)

    smart_targeted = getattr(a, "smart_list", None) or getattr(a, "smart_list_id", None) is not None
    smart_ref = None
    expected_order = None
    if smart_targeted:
        smart_ref, expected_order, request = _smart_list_move_request(
            db, a, reminder, relation, anchor
        )
    else:
        if anchor is not None and anchor["ZLIST"] != reminder["ZLIST"]:
            print("Error: reminders in different lists require --smart-list or --smart-list-id.", file=sys.stderr)
            sys.exit(1)
        list_uuid = q_list_ckid(db, reminder["ZLIST"])
        if not list_uuid:
            print("Error: target list has no stable identifier.", file=sys.stderr)
            sys.exit(1)
        current_order = q_list_reminder_order(db, reminder["ZLIST"])
        if not current_order:
            print("Error: this list has no readable ReminderKit ordering data.", file=sys.stderr)
            sys.exit(1)
        try:
            expected_order = reorder_identifier_list(
                current_order,
                reminder["ZCKIDENTIFIER"],
                relation,
                anchor["ZCKIDENTIFIER"] if anchor is not None else None,
            )
        except ValueError as exc:
            if str(exc) == "anchor_missing":
                print("Error: the anchor has no persisted position in this list.", file=sys.stderr)
                sys.exit(1)
            raise
        request = {
            "action": "move_reminder_in_list",
            "id": reminder["ZCKIDENTIFIER"],
            "listId": list_uuid,
            "position": relation,
        }
        if anchor is not None:
            request["anchorId"] = anchor["ZCKIDENTIFIER"]

    if smart_ref is not None:
        read_order = lambda: _read_fresh_db_value(
            lambda current_db: (
                q_manual_sort_hint(
                    current_db, CUSTOM_SMART_LIST_MANUAL_ORDER_TYPE, smart_ref["objectUUID"]
                ) or {}
            ).get("topLevelElementIDs")
        )
    else:
        read_order = lambda: _read_fresh_db_value(
            lambda current_db: q_list_reminder_order(current_db, reminder["ZLIST"])
        )

    result = private_call(request)
    helper_reported_error = not result or result.get("status") != "updated"
    verified = _wait_for_order(read_order, expected_order)
    if helper_reported_error and not verified:
        message = result.get("message") if isinstance(result, dict) else "private helper failed"
        print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)
    if not verified:
        print("Error: ReminderKit reported success, but the new reminder order could not be verified.", file=sys.stderr)
        sys.exit(1)

    payload = {
        "status": "updated",
        "id": a.id,
        "title": reminder["ZTITLE"],
        "position": relation,
        "verified": True,
    }
    if helper_reported_error:
        payload["verifiedAfterHelperError"] = True
    if anchor is not None:
        payload.update({"anchorId": anchor_id, "anchorTitle": anchor["ZTITLE"]})
    if smart_ref is not None:
        payload["smartList"] = smart_ref["title"]
    else:
        payload["list"] = reminder["list_name"]
    if a.json:
        print(json.dumps(payload, ensure_ascii=False))
    else:
        destination = f"smart list {smart_ref['title']!r}" if smart_ref else f"list {reminder['list_name']!r}"
        anchor_text = f" #{anchor_id}" if anchor_id is not None else ""
        print(f"Moved #{a.id} {relation}{anchor_text} in {destination}.")


def search_page_args(a):
    """Validated (limit, offset, paged) for search; paged means the caller asked for pages."""
    limit = getattr(a, "limit", None)
    offset = getattr(a, "offset", None)
    if limit is not None and not 1 <= limit <= SEARCH_MAX_LIMIT:
        print(f"Error: --limit must be between 1 and {SEARCH_MAX_LIMIT}.", file=sys.stderr)
        sys.exit(1)
    if offset is not None and offset < 0:
        print("Error: --offset must be 0 or more.", file=sys.stderr)
        sys.exit(1)
    paged = limit is not None or offset is not None
    return (limit or SEARCH_DEFAULT_LIMIT), (offset or 0), paged


def cmd_search(a):
    if eventkit_read_requested(a):
        cmd_search_eventkit(a)
        return
    limit, offset, paged = search_page_args(a)
    db = open_db()
    list_ref = None
    if getattr(a, "list", None) or getattr(a, "list_id", None) is not None:
        list_ref = resolve_required_list_target_or_die(db, name=getattr(a, "list", None), list_id=getattr(a, "list_id", None))
    list_pk = list_ref["id"] if list_ref else None
    items = q_search(db, a.query, completed=a.completed, list_pk=list_pk, limit=limit, offset=offset)
    total = q_search_count(db, a.query, completed=a.completed, list_pk=list_pk)
    next_offset = offset + len(items) if offset + len(items) < total else None
    pks = [i["Z_PK"] for i in items]
    sc, ht = preload_extras(db, pks)
    att = preload_attachments(db, pks)
    ind = preload_indicators(db, pks)
    if a.json:
        rows = [to_dict(i, db, _sc=sc, _ht=ht, _att=att) for i in items]
        if paged:
            payload = {
                "query": a.query,
                "items": rows,
                "count": len(rows),
                "total": total,
                "offset": offset,
                "limit": limit,
                "hasMore": next_offset is not None,
                "nextOffset": next_offset,
            }
            if list_ref:
                payload["list"] = {"id": list_ref["id"], "title": list_ref["title"]}
            print(json.dumps(payload, indent=2))
        else:
            # The bare array stays for existing scripts; stderr says when it is cut short.
            if next_offset is not None:
                print(
                    f"Warning: showing {len(rows)} of {total} matches. "
                    f"Pass --offset {next_offset} --limit {limit} for the next page.",
                    file=sys.stderr,
                )
            print(json.dumps(rows, indent=2))
        return
    if getattr(a, 'format', None) == 'table':
        print_reminder_table(items, db, args=a)
        if next_offset is not None:
            print(f"Showing {len(items)} of {total} matches. Next page: --offset {next_offset}", file=sys.stderr)
        return
    scope = f" in {safe_display(list_ref['title'])}" if list_ref else ""
    if not items:
        if total and offset:
            print(f"No reminders matching '{safe_display(a.query)}'{scope} past offset {offset} ({total} total)")
        else:
            print(f"No reminders matching '{safe_display(a.query)}'{scope}")
        return
    print(f"Search: {C.bold(safe_display(a.query))}{scope}")
    img = _image_render_config_verbose(a)
    for i in items:
        print(fmt(i, db, verbose=a.verbose, _sc=sc, _ht=ht, _img=img, _ind=ind))
    if len(items) == total:
        print(f"\n{total} result{'s' if total != 1 else ''}")
    else:
        print(f"\nShowing {offset + 1}-{offset + len(items)} of {total} results")
        if next_offset is not None:
            print(f"Next page: --offset {next_offset}")

