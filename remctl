        formatter_class=HelpFormatter,
    )
    c.add_argument("name", nargs="?", help="Group name")
    c.add_argument("--group-id", type=int, help="Read by numeric group ID from groups")
    js(c)

    c = sub.add_parser(
        "group-create",
        help="Create a Reminders list group",
        description=(
            "Create a Reminders list group through unsupported private ReminderKit APIs. "
            "Optionally move existing lists into the new group without moving or deleting their reminders."
        ),
        epilog=(
            "Examples:\n"
            "  remctl group-create Writing --private\n"
            "  remctl group-create Writing --private --add-list Editorial --add-list-id 475 --json\n"
        ),
        formatter_class=HelpFormatter,
    )
    c.add_argument("name", help="Group name")
    c.add_argument("--add-list", action="append", help="Move an existing list into the new group by name; repeatable")
    c.add_argument("--add-list-id", action="append", type=int, help="Move an existing list into the new group by numeric ID; repeatable")
    c.add_argument("--private", action="store_true", help="Required for private ReminderKit group creation")
    js(c)

