def _date_components_dict(value):
    if value in (None, ""):
        return None
    if isinstance(value, bytes):
        value = value.decode("utf-8", "replace")
    try:
        parsed = json.loads(value)
    except (TypeError, ValueError):
        return None
    return parsed if isinstance(parsed, dict) else None

def _date_components_iso(components):
    if not components:
        return None
    try:
        year = int(components["year"])
        month = int(components["month"])
        day = int(components["day"])
        hour = int(components.get("hour", 0))
        minute = int(components.get("minute", 0))
        second = int(components.get("second", 0))
    except (KeyError, TypeError, ValueError):
        return None
    return f"{year:04d}-{month:02d}-{day:02d}T{hour:02d}:{minute:02d}:{second:02d}"

def _relative_alarm_label(seconds):
    try:
        seconds = int(seconds)
    except (TypeError, ValueError):
        return None
    value = abs(seconds)
    units = (
        (86400, "day"),
        (3600, "hour"),
        (60, "minute"),
    )
    for unit_seconds, unit_name in units:
        if value and value % unit_seconds == 0:
            amount = value // unit_seconds
            break
    else:
        amount, unit_name = value, "second"
    plural = "" if amount == 1 else "s"
    direction = "before due date" if seconds < 0 else "after due date"
    return f"{amount} {unit_name}{plural} {direction}"

def alarm_rows_to_json(rows):
    alarms = []
    for row in rows:
        alarm = {"id": row["alarm_id"]}
        interval = _row_get(row, "time_interval")
        if interval is not None:
            seconds = int(interval)
            minutes = seconds / 60
            if seconds % 60 == 0:
                minutes = int(minutes)
            alarm.update({
                "type": "relative",
                "relativeOffset": seconds,
                "relativeOffsetMinutes": minutes,
            })
            label = _relative_alarm_label(seconds)
            if label:
                alarm["label"] = label
        elif _row_get(row, "latitude") is not None or _row_get(row, "longitude") is not None:
            proximity_code = _row_get(row, "proximity")
            alarm.update({
                "type": "location",
                "location": {
                    "title": _row_get(row, "location_title") or "Location",
                    "latitude": _row_get(row, "latitude"),
                    "longitude": _row_get(row, "longitude"),
                    "radius": _row_get(row, "radius"),
                    "proximity": "leaving" if proximity_code == 2 else "arriving",
                    "proximityCode": proximity_code,
                },
            })
            address = _row_get(row, "address")
            if address:
                alarm["location"]["address"] = address
        else:
            components = _date_components_dict(_row_get(row, "date_components"))
            if components:
                alarm.update({
                    "type": "absolute",
                    "dateComponents": components,
                })
                iso_date = _date_components_iso(components)
                if iso_date:
                    alarm["date"] = iso_date
                timezone = components.get("timeZone")
                if isinstance(timezone, dict) and timezone.get("identifier"):
                    alarm["timeZone"] = timezone["identifier"]
            else:
                alarm["type"] = "unknown"
        alarms.append(alarm)
    return alarms


def due_date_delta_alert_rows_to_json(rows):
    alerts = []
    for row in rows:
        try:
            unit_raw = int(row["ZDUEDATEDELTAUNIT"])
            count = int(row["ZDUEDATEDELTACOUNT"])
        except (TypeError, ValueError, KeyError, IndexError):
            continue
        singular, plural = DUE_DATE_DELTA_UNITS.get(unit_raw, ("unknown", "unknown"))
        value = abs(count)
        unit_name = singular if value == 1 else plural
        direction = "before" if count < 0 else "after"
        alert = {
            "unit": unit_name,
            "unitCode": unit_raw,
            "count": count,
            "value": value,
            "direction": direction,
            "label": f"{value} {unit_name} {direction}",
        }
        identifier = uuid_from_blob(_row_get(row, "ZIDENTIFIER"))
        if identifier:
            alert["identifier"] = identifier
        creation_date = _row_get(row, "ZCREATIONDATE")
        if creation_date:
            alert["creationDate"] = ts(creation_date).isoformat()
        acknowledged_date = _row_get(row, "ZACKNOWLEDGEDDATE")
        if acknowledged_date:
            alert["acknowledgedDate"] = ts(acknowledged_date).isoformat()
        minimum_supported = _row_get(row, "ZMINIMUMSUPPORTEDAPPVERSION")
        if minimum_supported is not None:
            alert["minimumSupportedAppVersion"] = minimum_supported
        alerts.append(alert)
    return alerts


def _same_datetime_second(left, right):
    if not left or not right:
        return False
    return int(left.timestamp()) == int(right.timestamp())

def _parse_alarm_iso_datetime(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(value)
    except (TypeError, ValueError):
        return None

def _absolute_alarm_datetimes(db, reminder):
    """Dates of the reminder's alarms, or None unless every alarm is absolute.

    Reminders can store the same alarm more than once: each device that
    handles the notification writes its own acknowledged copy, and both
    sync. Callers treat such copies as one alarm.
    """
    if db is None:
        return None
    reminder_pk = _row_get(reminder, "Z_PK")
    if not reminder_pk:
        return None
    try:
        alarms = alarm_rows_to_json(q_alarms(db, reminder_pk))
    except Exception:
        return None
    if not alarms or any(alarm.get("type") != "absolute" for alarm in alarms):
        return None
    dates = [_parse_alarm_iso_datetime(alarm.get("date")) for alarm in alarms]
    if any(date is None for date in dates):
        return None
    return dates

def should_carry_absolute_alarm_to_new_due(db, reminder, new_due, explicit_alarm=False):
    """Keep Reminders.app's visible time aligned when moving due-at-time items.

    Reminders shows a reminder at its absolute alarm (ZDISPLAYDATEDATE follows
    it). EventKit does not move that alarm when only dueDateComponents change,
    so a plain `edit -d` can leave the app showing the old time. Carry the
    alarm when every alarm is absolute and at the old due time, however many
    copies there are; otherwise preserve the user's custom alarm setup.
    """
    if explicit_alarm or new_due is None:
        return False
    alarm_dates = _absolute_alarm_datetimes(db, reminder)
    if not alarm_dates:
        return False
    old_due = ts(_row_get(reminder, "ZDUEDATE"))
    return all(_same_datetime_second(alarm_dt, old_due) for alarm_dt in alarm_dates)

def should_clear_matching_absolute_alarm(db, reminder):
    alarm_dates = _absolute_alarm_datetimes(db, reminder)
    if not alarm_dates:
        return False
    old_due = ts(_row_get(reminder, "ZDUEDATE"))
    old_display = ts(_row_get(reminder, "ZDISPLAYDATEDATE"))
    return all(
        any(_same_datetime_second(alarm_dt, candidate) for candidate in (old_due, old_display))
        for alarm_dt in alarm_dates
    )

def hydrate_reminder_detail(db, payload, reminder_id):
    if "attachments" not in payload:
        # to_dict already resolves attachments when it runs with a db; skip
        # the re-query/re-resolution in that case (info --json path).
        attachments = attachment_rows_to_json(q_attachments(db, reminder_id))
        if attachments:
            payload["attachments"] = attachments
    alarms = alarm_rows_to_json(q_alarms(db, reminder_id))
    if alarms:
        payload["alarms"] = alarms
    return payload

SEARCH_DEFAULT_LIMIT = 100
SEARCH_MAX_LIMIT = 500


def search_fold(value):
    """Fold text for search: case-insensitive and accent-insensitive.

    NFKD splits "é" into "e" plus a combining accent, which is dropped, and
    casefold() handles cases lower() misses ("ß" matches "ss"). The query and
    every searched field go through the same fold, so "cafe" finds "Café".
    """
    if value is None:
        return ""
    decomposed = unicodedata.normalize("NFKD", str(value))
    return "".join(ch for ch in decomposed if not unicodedata.combining(ch)).casefold()


def _search_where(db, query, completed=False, list_pk=None):
    """WHERE clause and parameters shared by the search page and its total count.

    Matching uses instr() on folded text instead of LIKE, so %, _, and
    backslashes in a query are ordinary characters. Saved rich links live in
    ZREMCDOBJECT rows, not in the notes, so they are matched separately.
    """
    db.create_function("remctl_fold", 1, search_fold, deterministic=True)
    folded = search_fold(query)
    fields = ["instr(remctl_fold(r.ZTITLE), ?) > 0", "instr(remctl_fold(r.ZNOTES), ?) > 0"]
    params = [folded, folded]
    if "ZURL" in table_column_names(db, "ZREMCDOBJECT"):
        fields.append(
            "EXISTS (SELECT 1 FROM ZREMCDOBJECT o WHERE o.ZREMINDER2 = r.Z_PK "
            "AND o.ZURL IS NOT NULL AND o.ZMARKEDFORDELETION = 0 "
            "AND instr(remctl_fold(o.ZURL), ?) > 0)"
        )
        params.append(folded)
    clauses = [
        "r.ZMARKEDFORDELETION = 0", "r.ZACCOUNT IS NOT NULL", "l.Z_PK IS NOT NULL",
        f"({' OR '.join(fields)})",
    ]
    if not completed:
        clauses.append("r.ZCOMPLETED = 0")
    if list_pk is not None:
        clauses.append("r.ZLIST = ?")
        params.append(list_pk)
    return " AND ".join(clauses), params


def q_search(db, query, completed=False, *, list_pk=None, limit=SEARCH_DEFAULT_LIMIT, offset=0):
    """One page of matches in titles, notes, and saved links, newest first."""
    where, params = _search_where(db, query, completed=completed, list_pk=list_pk)
    return db.execute(
        f"SELECT {rem_cols(db)} FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l "
        f"ON r.ZLIST = l.Z_PK WHERE {where} ORDER BY r.Z_PK DESC LIMIT ? OFFSET ?",
        (*params, limit, offset),
    ).fetchall()


def q_search_count(db, query, completed=False, *, list_pk=None):
    """How many reminders match, across every page."""
    where, params = _search_where(db, query, completed=completed, list_pk=list_pk)
    return db.execute(
        f"SELECT COUNT(*) FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l "
        f"ON r.ZLIST = l.Z_PK WHERE {where}",
        params,
    ).fetchone()[0]

