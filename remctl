def run_handler_with_fallback(args, handler):
    try:
        handler(args)
    except RemindersDBUnavailable as exc:
        print(f"Error: {exc}", file=sys.stderr)
        if (
            getattr(args, "cmd", None) in EVENTKIT_READ_COMMANDS
            and hasattr(args, "via_eventkit")
            and not eventkit_read_requested(args)
        ):
            access_context = (
                "while the signed Capability Host lacks Full Disk Access"
                if os.environ.get(CAPABILITY_HOST_ACTIVE_ENV) == "1"
                else "when Full Disk Access is unavailable"
            )
            print(
                "Limited fallback: rerun with --via-eventkit for a read-only EventKit result "
                f"{access_context}. This mode is not full fidelity and does "
                "not return RemCTL numeric ids.",
                file=sys.stderr,
            )
        sys.exit(1)


def _should_route_capability_host(args):
    try:
        return remctl_broker.should_route(args)
    except ValueError as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(2)


def _dispatch_capability_host(argv, args):
    """Run one already-parsed command in the signed capability host."""

    try:
        exit_code = remctl_broker.dispatch(argv, parsed_args=args)
        remctl_broker.exit_with_status(exit_code)
    except remctl_broker.CapabilityHostError as exc:
        code = getattr(exc, "code", "capability_host_error")
        print(f"Error: RemCTL Capability Host [{code}]: {exc}", file=sys.stderr)
        if getattr(exc, "indeterminate", False):
            print(
                "The request may have run. RemCTL did not retry or fall back to direct execution; "
                "inspect the exact reminder or list state before retrying.",
                file=sys.stderr,
            )
        sys.exit(1)


def _no_command_host_argv(args):
    """Translate the local splash invocation into one normalized hosted today command."""

    argv = []
    if getattr(args, "no_color", False) or os.environ.get("NO_COLOR"):
        argv.append("--no-color")
    argv.append("today")
    argv.extend(["--format", getattr(args, "format", "plain")])
    if getattr(args, "images", False):
        argv.append("--images")
    image_mode = getattr(args, "image_mode", None)
    if not image_mode and getattr(args, "images", False):
        image_mode = detect_image_mode()
    if image_mode:
        argv.extend(["--image-mode", image_mode])
    image_width = getattr(args, "image_width", None)
    if image_width is not None:
        argv.extend(["--image-width", str(image_width)])
    return argv


def _normalized_host_argv(argv, args):
    """Make caller-side presentation defaults explicit for the sanitized host."""

    values = list(argv)
    try:
        option_end = values.index("--")
    except ValueError:
        option_end = len(values)
    option_values = values[:option_end]
    prefix = []
    if (
        (getattr(args, "no_color", False) or os.environ.get("NO_COLOR"))
        and "--no-color" not in option_values
    ):
        prefix.append("--no-color")
    if getattr(args, "images", False) and "--images" not in option_values:
        prefix.append("--images")
    image_mode = getattr(args, "image_mode", None)
    if not image_mode and getattr(args, "images", False):
        image_mode = detect_image_mode()
    if image_mode and not any(
        value == "--image-mode" or value.startswith("--image-mode=")
        for value in option_values
    ):
        prefix.extend(["--image-mode", image_mode])
    image_width = getattr(args, "image_width", None)
    if image_width is not None and not any(
        value == "--image-width" or value.startswith("--image-width=")
        for value in option_values
    ):
        prefix.extend(["--image-width", str(image_width)])
    return prefix + values


def cmd_completion(a):
    shell = a.shell if hasattr(a, 'shell') and a.shell else "zsh"
    try:
        sys.stdout.write(get_completion_script(shell, command_name=CLI_NAME))
    except ValueError as exc:
        print(f"Error: {exc}. Use bash, zsh, or fish.", file=sys.stderr)
        sys.exit(1)


DOCTOR_PERMISSION_STATUS = {"authorized": "ok", "unverified": "warn", "blocked": "fail"}


def gather_doctor_checks(capability_host=None):
    checks = []
    host_status = capability_host or capability_host_status_snapshot()
    mode = capability_host_requested_mode()
    host_effective = capability_host_is_effective(host_status)
    host_store_ready = host_effective and bool(host_status.get("ready"))
    host_start_fix = capability_host_start_fix(host_status) if host_effective else None

    def add(name, status, detail, fix=None):
        checks.append({"name": name, "status": status, "detail": detail, "fix": fix})

    is_darwin = sys.platform == "darwin"
    add(
        "platform",
        "ok" if is_darwin else "fail",
        f"{platform.system()} {platform.mac_ver()[0] or platform.release()}",
        None if is_darwin else "RemCTL only supports macOS.",
    )

    py_ok = sys.version_info >= (3, 10)
    add(
        "python",
        "ok" if py_ok else "fail",
        platform.python_version(),
        None if py_ok else "Install Python 3.10 or newer.",
    )

    store_exists = STORE_DIR.exists()
    add(
        "store_dir",
        "ok" if store_exists else ("warn" if host_store_ready else "fail"),
        str(STORE_DIR),
        (
            None
            if store_exists
            else (
                "Direct access is unavailable in this caller; the signed Capability Host "
                "can read the store."
                if host_store_ready
                else "Set REMCTL_STORE_DIR if your Reminders store lives elsewhere."
            )
        ),
    )

    db_access_error = reminders_store_access_error()
    db_path = find_main_db_path()
    if db_access_error:
        add(
            "database",
            "warn" if host_store_ready else "fail",
            db_access_error,
            (
                "Direct caller access is blocked, but effective database access is available "
                "through the signed RemCTL Capability Host."
                if host_store_ready
                else full_disk_access_fix_text(
                    rerun_command="remctl doctor --for-agent",
                    mention_onboard=True,
                    host_status=host_status,
                )
            ),
        )
    else:
        add(
            "database",
            "ok" if db_path else ("warn" if host_store_ready else "fail"),
            str(db_path) if db_path else "No Reminders database found",
            (
                None
                if db_path
                else (
                    "Direct caller access is unavailable, but effective database access is "
                    "available through the signed RemCTL Capability Host."
                    if host_store_ready
                    else "Enable iCloud Reminders and open Reminders.app once, or run remctl onboard."
                )
            ),
        )
    direct_database_ready = not db_access_error and bool(db_path)

    cli_path = current_cli_path()
    cli_on_path = shutil.which(CLI_NAME) is not None
    add(
        "cli",
        "ok" if cli_path.exists() else "fail",
        str(cli_path),
        None if cli_on_path else f"Add {cli_path.parent} to PATH.",
    )

    bridge_path = current_bridge_path()
    bridge_ok = bridge_path.exists() and os.access(bridge_path, os.X_OK)
    bridge_fix = None
    if host_effective:
        bridge_ok = bool(host_status.get("available"))
        bridge_fix = None if bridge_ok else (host_start_fix or "Restart or reinstall the signed RemCTL Capability Host.")
    elif not bridge_ok:
        bridge_fix = "Run ./install.sh or compile remctl-bridge.swift with swiftc, then run remctl onboard."
    add(
        "bridge",
        "ok" if bridge_ok else "warn",
        (
            "Sealed EventKit bridge in the signed Capability Host."
            if host_effective
            else str(bridge_path)
        ),
        bridge_fix,
    )
    if host_effective:
        permissions = host_status.get("permissions")
        reminders_access = permissions.get("reminders") if isinstance(permissions, dict) else None
        reminders_state = host_permission_state(reminders_access)
        add(
            "eventkit",
            DOCTOR_PERMISSION_STATUS[reminders_state],
            f"Capability Host Reminders access: {reminders_access or 'unknown'}",
            {
                "authorized": None,
                "unverified": "The host has not verified Reminders access yet. Rerun `remctl doctor`.",
                "blocked": "Run `remctl onboard` to request Reminders access for the signed host.",
            }[reminders_state],
        )
        automation_access = permissions.get("automation") if isinstance(permissions, dict) else None
        automation_state = host_permission_state(automation_access)
        add(
            "automation",
            DOCTOR_PERMISSION_STATUS[automation_state],
            f"Capability Host Automation access: {automation_access or 'unknown'}",
            {
                "authorized": None,
                "unverified": (
                    "macOS cannot report Automation access until Reminders has run once. "
                    "Only flag and unflag need it; reads and writes are unaffected."
                ),
                "blocked": "Run `remctl onboard` to request Automation access for the signed host.",
            }[automation_state],
        )
    elif mode == "direct" and bridge_ok:
        checks.append(bridge_access_check_for_onboarding())
    else:
        add(
            "eventkit",
            "warn",
            (
                "Direct EventKit access was not checked because the signed Capability Host is unavailable."
                if mode != "direct"
                else "EventKit write access was not checked because remctl-bridge is unavailable."
            ),
            "Reinstall the signed RemCTL Capability Host." if mode != "direct" else bridge_fix,
        )

    private_path = current_private_path()
    private_ok = private_path.exists() and os.access(private_path, os.X_OK)
    private_detail = str(private_path)
    private_fix = None
    if host_effective:
        private_ok = bool(host_status.get("available"))
        private_detail = "Sealed private ReminderKit helper in the signed Capability Host."
        if not private_ok:
            private_fix = "Restart or reinstall the signed RemCTL Capability Host."
    elif mode == "direct" and private_ok:
        probe = _probe_private_protocol_version()
        if probe.get("ok"):
            private_detail = f"{private_path} (protocol {probe['version']})"
        elif probe.get("reason") == "outdated":
            private_ok = False
            version = probe.get("version", 0)
            private_detail = f"{private_path} (protocol {version} < required {PRIVATE_PROTOCOL_VERSION})"
            private_fix = "Re-run ./install.sh to rebuild remctl-private."
        elif probe.get("message"):
            private_detail = f"{private_path} ({probe['message']})"
    elif mode == "direct":
        private_fix = "Run ./install.sh to compile remctl-private, or avoid --private writes."
    else:
        private_ok = False
        private_detail = "Signed Capability Host is unavailable; its sealed private helper was not checked."
        private_fix = "Reinstall the signed RemCTL Capability Host."
    add(
        "private_helper",
        "ok" if private_ok else "warn",
        private_detail,
        private_fix,
    )

    permissions_path = current_permissions_path()
    permissions_ok = permissions_path.exists() and os.access(permissions_path, os.X_OK)
    add(
        "permissions_helper",
        "ok" if permissions_ok else "warn",
        str(permissions_path),
        None if permissions_ok else "Run ./install.sh to compile remctl-permissions for the guided Full Disk Access flow.",
    )

    config_ok = CONFIG_DIR.exists()
    add(
        "config_dir",
        "ok" if config_ok else "warn",
        str(CONFIG_DIR),
        None if config_ok else "Run remctl setup to create config files.",
    )

    shell = detect_shell_name()
    if shell in {"zsh", "bash", "fish"}:
        completion_path = completion_target_path(shell)
        completion_exists = completion_path.exists()
        add(
            "completion",
            "ok" if completion_exists else "warn",
            f"{shell}: {completion_path}",
            None if completion_exists else f"Run remctl setup --shell {shell} to install completion.",
        )
        if shell == "zsh" and completion_exists:
            loadable = zsh_completion_loadable(completion_path)
            if loadable is True:
                add("completion_fpath", "ok", f"{completion_path.parent} is on zsh fpath", None)
            elif loadable is False:
                add(
                    "completion_fpath",
                    "warn",
                    f"{completion_path.parent} is not on zsh fpath",
                    zsh_completion_hint(completion_path),
                )
            else:
                add(
                    "completion_fpath",
                    "warn",
                    f"Could not verify zsh fpath for {completion_path.parent}",
                    zsh_completion_hint(completion_path),
                )
    else:
        add("completion", "warn", f"Unsupported shell '{shell}'", "Run remctl setup --shell zsh|bash|fish.")

    try:
        overview = mcp_overview()
    except (OSError, ValueError) as exc:
        add("mcp_clients", "warn", f"Could not read MCP client configuration: {exc}", "Run `remctl mcp status`.")
    else:
        mcp_clients = overview["clients"]
        tailscale = overview.get("tailscale") or {}
        connected = [client["name"] for client in mcp_clients if client["configured"] and client.get("current") is not False]
        stale = [client for client in mcp_clients if client["configured"] and client.get("current") is False]
        installed = [client["name"] for client in mcp_clients if client["installed"]]
        if tailscale.get("configured") and tailscale.get("active"):
            connected.append(f"tailnet devices at {tailscale.get('url')}")
        if stale:
            add(
                "mcp_clients",
                "warn",
                mcp_stale_clients_text(stale),
                "Run `remctl mcp install` to update the connected apps.",
            )
        elif connected:
            add("mcp_clients", "ok", "MCP server connected to " + ", ".join(connected), None)
        elif installed:
            add(
                "mcp_clients",
                "warn",
                "MCP server not connected to " + ", ".join(installed),
                "Run `remctl mcp install` (or `remctl onboard`) to connect AI apps.",
            )
        else:
            add("mcp_clients", "ok", "No supported AI app detected; `remctl mcp config` prints a generic snippet", None)
        if tailscale.get("configured") and not tailscale.get("active"):
            add(
                "mcp_tailscale",
                "warn",
                "Tailnet endpoint is configured but not serving"
                + ("" if tailscale.get("agentRunning") else " (service not running)")
                + ("" if tailscale.get("served") else " (tailscale serve mount missing)"),
                "Run `remctl mcp install --client tailscale` to repair, or `remctl mcp remove --client tailscale` to turn it off.",
            )
        elif tailscale.get("configured") and tailscale.get("agentInterpreterProblem"):
            add(
                "mcp_tailscale",
                "warn",
                "Tailnet endpoint service "
                + MCP_STALE_REASONS.get(tailscale["agentInterpreterProblem"], MCP_STALE_REASONS["interpreter_missing"]),
                "Run `remctl mcp install --client tailscale` to rewrite the service with a stable Python path.",
            )

    if mode == "invalid":
        add(
            "capability_host",
            "fail",
            "REMCTL_CAPABILITY_HOST has an invalid value.",
            "Use REMCTL_CAPABILITY_HOST=auto, force, or direct.",
        )
        effective_route = "unavailable"
        effective_ready = False
    elif mode == "direct":
        add(
            "capability_host",
            "ok",
            "Direct mode requested; the Capability Host is intentionally bypassed.",
        )
        effective_route = "direct"
        effective_ready = direct_database_ready
    elif host_effective:
        full_ready = bool(host_status.get("fullReady"))
        error = host_status.get("error")
        error_detail = error.get("message") if isinstance(error, dict) else error
        # fullReady also covers a refused grant, an incompatible private helper
        # and a missing bridge. An unverified permission is the one cause that
        # clears itself, so it must not read as a broken install.
        unverified = host_permissions_unverified(host_status)
        settling = bool(unverified) and not error_detail
        if full_ready:
            add("capability_host", "ok", "Signed Capability Host is ready for full RemCTL execution.")
        elif settling:
            add(
                "capability_host",
                "warn",
                "Capability Host is running; it has not verified "
                f"{' and '.join(unverified)} access yet.",
                "Rerun `remctl doctor` in a moment; the host verifies access on its own.",
            )
        else:
            add(
                "capability_host",
                "fail",
                str(error_detail or "Capability Host is installed but is not fully ready."),
                host_start_fix or "Run `remctl onboard`, then rerun `remctl doctor --for-agent`.",
            )
        effective_route = "capabilityHost"
        # Reads and writes run through the host's EventKit and database access,
        # which stays usable while a permission is merely unverified.
        effective_ready = full_ready or (settling and bool(host_status.get("ready")))
    else:
        add(
            "capability_host",
            "warn",
            "Capability Host is not installed; auto mode is using direct execution.",
            "Run ./install.sh to install the signed RemCTL Capability Host.",
        )
        effective_route = "direct"
        effective_ready = direct_database_ready

    add(
        "effective_access",
        "ok" if effective_ready else "fail",
        f"route={effective_route}; ready={'yes' if effective_ready else 'no'}",
        None if effective_ready else (host_start_fix or "Run `remctl onboard` and resolve the failed checks above."),
    )

    return checks


def cmd_doctor(a):
    capability_host = capability_host_status_settled()
    checks = gather_doctor_checks(capability_host)
    context = doctor_execution_context()
    fail_count = sum(1 for check in checks if check["status"] == "fail")
    warn_count = sum(1 for check in checks if check["status"] == "warn")
    result = {
        "ok": fail_count == 0,
        "warnings": warn_count,
        "failures": fail_count,
        "context": context,
        "access": {
            "requestedMode": capability_host_requested_mode(),
            "direct": {
                "ready": next(
                    (check["status"] == "ok" for check in checks if check["name"] == "database"),
                    False,
                ),
            },
            "effective": {
                "route": next(
                    (
                        check["detail"].split(";", 1)[0].removeprefix("route=")
                        for check in checks
                        if check["name"] == "effective_access"
                    ),
                    "unavailable",
                ),
                "ready": next(
                    (check["status"] == "ok" for check in checks if check["name"] == "effective_access"),
                    False,
                ),
            },
        },
        "capabilityHost": capability_host,
        "checks": checks,
    }
    if getattr(a, "for_agent", False):
        result["agent_note"] = (
            "Use `access.effective` as the authoritative readiness result. A caller such as "
            "Hermes may show blocked direct access while the signed Capability Host provides "
            "full effective access."
        )
    if getattr(a, "json", False):
        print(json.dumps(result, indent=2))
    else:
        print(C.bold("RemCTL doctor"))
        print(f"Context: {context.get('effective_context') or 'unknown'}")
        print(f"Python: {context.get('python')}")
        parent = context.get("parent_process") or {}
        if parent:
            print(f"Parent process: {parent.get('name')} (pid {parent.get('pid')})")
        if context.get("host_app"):
            print(f"Host app: {context.get('host_app')}")
        if context.get("terminal_app"):
            print(f"Terminal app: {context.get('terminal_app')}")
        print(f"Requested route: {result['access']['requestedMode']}")
        print(
            f"Effective access: {result['access']['effective']['route']} "
            f"({'ready' if result['access']['effective']['ready'] else 'not ready'})"
        )
        app = capability_host.get("app") if isinstance(capability_host.get("app"), dict) else {}
        socket_status = capability_host.get("socket") if isinstance(capability_host.get("socket"), dict) else {}
        print(
            "Capability Host: "
            f"{'full ready' if capability_host.get('fullReady') else 'not ready'}; "
            f"protocol {capability_host.get('protocolVersion') or '?'}"
            f"/{capability_host.get('expectedProtocolVersion') or '?'}"
        )
        if app.get("path"):
            print(f"Capability Host app: {app.get('path')}")
        if socket_status.get("path"):
            print(f"Capability Host socket: {socket_status.get('path')}")
        signature = capability_host.get("signature") or app.get("signature")
        if signature:
            print(f"Capability Host signature: {signature}")
        permissions = capability_host.get("permissions")
        if isinstance(permissions, dict):
            permission_summary = ", ".join(
                f"{key}={permissions.get(key)}"
                for key in ("fullDiskAccess", "reminders", "automation")
                if key in permissions
            )
            if permission_summary:
                print(f"Capability Host permissions: {permission_summary}")
        if getattr(a, "for_agent", False):
            print(
                "Agent note: effective access is authoritative. Direct caller access may remain "
                "blocked when the signed Capability Host is ready."
            )
        print()
        print_check_report(None, checks)
    if fail_count:
        sys.exit(1)


def cmd_onboard(a):
    result = run_onboarding(auto=False)
    skip_mcp = getattr(a, "no_mcp", False)
    skip_tailscale = skip_mcp or getattr(a, "no_tailscale", False)
    if getattr(a, "json", False):
        if not skip_mcp:
            result["mcp"] = mcp_overview()
        print(json.dumps(result, indent=2))
        if result["failures"]:
            sys.exit(1)
        return

    cli_path = mcp_cli_path()
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    mode = capability_host_requested_mode()
    tailscale = None if skip_tailscale else remctl_tailscale_detect()
    show_tailscale = bool(tailscale and tailscale.get("installed"))
    total = 2 + (0 if skip_mcp else 1) + (1 if show_tailscale else 0)

    print(C.bold("RemCTL onboarding") + C.dim(f"  v{VERSION}"))
    print(C.dim("A few steps, one question at a time. Nothing is changed without asking."))

    # Step 1: macOS permissions.
    blurb = (
        ["Direct mode: this caller uses its own macOS permissions."]
        if mode == "direct"
        else [
            "RemCTL reads and writes Reminders through its signed Capability Host app.",
            "macOS asks you to allow Reminders and Automation for that app once.",
        ]
    )
    onboarding_step(1, total, "macOS permissions", blurb)
    for check in result["checks"]:
        label = ONBOARD_CHECK_LABELS.get(check["name"], check["name"].replace("_", " "))
        status = check["status"] if check["status"] in ("ok", "warn", "fail") else "info"
        detail = check.get("detail") or ""
        text = label if status == "ok" else f"{label}: {detail}"
        onboarding_line(status, text, fix=check.get("fix") if status != "ok" else None)
    database_check = next((check for check in result["checks"] if check["name"] == "database"), None)
    if needs_full_disk_access_guidance(database_check):
        host_status = result.get("capabilityHost") or capability_host_status_snapshot()
        host_targets = capability_host_target_specs(host_status)
        if mode == "direct":
            print()
            for line in full_disk_access_fix_text(rerun_command="remctl doctor").splitlines():
                print(C.dim(f"  {line}"))
        elif host_targets and launch_full_disk_access_helper(targets=host_targets):
            print_permission_helper_opened()
        elif host_targets:
            print_capability_host_full_disk_access_guidance(host_status, settings_opened=open_full_disk_access_settings())
        else:
            print_capability_host_full_disk_access_guidance(host_status, settings_opened=False)

    # Step 2: does it work?
    onboarding_step(2, total, "Health check")
    host_status = result.get("capabilityHost") or capability_host_status_snapshot()
    if mode == "direct":
        onboarding_line("info", "Direct mode; skipping the Capability Host check.")
        host_ready = result["failures"] == 0
    else:
        host_ready = capability_host_is_effective(host_status) and bool(host_status.get("fullReady"))
        if host_ready:
            onboarding_line("ok", f"Capability Host ready (protocol {host_status.get('protocolVersion')})")
        else:
            onboarding_line("fail", "Capability Host is not ready", fix="Finish the permission steps above, then run: remctl doctor")
    count = onboarding_today_count(cli_path) if host_ready else None
    if count is not None:
        onboarding_line("ok", f"{count} reminder{'s' if count != 1 else ''} due today or overdue")
    elif host_ready:
        onboarding_line("warn", "Could not read today's reminders yet", fix="Run `remctl today` after the checks above pass.")

    # Step 3: AI apps on this Mac.
    mcp_results = []
    step = 3
    if not skip_mcp:
        onboarding_step(step, total, "Connect your AI apps", [
            "Claude Code, Codex, and Claude Desktop get typed reminder tools through RemCTL's MCP server.",
            "Each app is registered through its own settings; you never edit config files by hand.",
        ])
        mcp_results = offer_mcp_connections(cli_path, interactive=interactive)
        step += 1

    # Step 4: other devices over Tailscale (only when Tailscale is installed).
    tailscale_result = None
    if show_tailscale:
        onboarding_step(step, total, "Your other devices (optional)", [
            f"Tailscale is on this Mac ({tailscale.get('hostname') or 'not connected'}).",
            "RemCTL can serve the same tools to Claude Code, Codex, and Claude Desktop on your other tailnet devices,",
            "over HTTPS with a private token. Nothing is exposed to the public internet.",
        ])
        tailscale_result = offer_tailscale(cli_path, tailscale, interactive=interactive)

    # Summary.
    print()
    print(C.bold("Done." if result["failures"] == 0 else "Almost done."))
    if result["failures"]:
        onboarding_line("info", "Fix the failed checks in step 1, then run: remctl doctor")
    onboarding_line("info", "Try it: remctl today")
    if any(item.get("client") == "claude-desktop" and item.get("ok") for item in mcp_results):
        onboarding_line("info", "Quit and reopen Claude Desktop so it picks up RemCTL (Cowork too).")
    if any(item.get("client") == "claude-code" and item.get("ok") for item in mcp_results):
        onboarding_line("info", "New Claude Code sessions see RemCTL; in an open session run /mcp.")
    if tailscale_result and tailscale_result.get("ok"):
        onboarding_line("info", "On another device, paste the command above. Reprint it: remctl mcp config --format tailscale")
    onboarding_line("info", "Check everything later with: remctl doctor")
    if result["failures"]:
        sys.exit(1)


