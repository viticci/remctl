            f"Error: {flag_list} modify how other filter options combine; "
            "pass at least one filter option (for example --tags, --priority, or --date) with them.",
            file=sys.stderr,
        )
        sys.exit(1)
    if not has_filter_changes and not has_appearance_changes:
        print("Error: pass at least one smart-list filter or appearance option.", file=sys.stderr)
        sys.exit(1)
    filter_data = None
    if has_filter_changes:
        try:
            filter_payload = smart_list_filter_payload_from_args(a, db)
            filter_data = encode_supported_filter_payload(filter_payload)
        except SmartListFilterError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            sys.exit(1)

    row = matches[0]
    request = {
        "action": "update_smart_list",
        "smartListId": row["ZCKIDENTIFIER"],
    }
    if filter_data is not None:
        request["filterData"] = base64.b64encode(filter_data).decode("ascii")
    request.update(list_private_appearance_payload(a))
    result = private_call(request)
    if not result or result.get("status") != "updated":
        message = result.get("message") if isinstance(result, dict) else "private helper failed"
        print(f"Error: Failed to edit smart list '{smart_list_display_name(row)}': {message}", file=sys.stderr)
        sys.exit(1)
    if a.json:
        payload = {
            "status": "updated",
            "id": row["Z_PK"],
            "objectUUID": row["ZCKIDENTIFIER"],
            "name": smart_list_display_name(row),
            "private": result,
        }
        if filter_data is not None:
            payload["filter"] = decode_smart_list_filter_blob(filter_data)["summary"]
        print(json.dumps(payload, ensure_ascii=False))
    else:
        print(f"Updated smart list: {safe_display(smart_list_display_name(row))}")
        summary = decode_smart_list_filter_blob(filter_data)["summary"] if filter_data is not None else None
        if summary:
            print(f"Filter: {safe_display(summary['description'])}")

