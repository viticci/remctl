def limited_eventkit_read(mode, a, **extra):
    if not bridge_available():
        _eventkit_read_error("remctl-bridge is required for --via-eventkit reads.", a, code="bridge_unavailable", exit_code=1)
    data = {
        "action": "read",
        "readMode": mode,
        "limit": 500,
    }
    data.update(extra)
    result = bridge_call(data)
    if not result or result.get("status") != "ok":
        message = (result or {}).get("message") if isinstance(result, dict) else None
        _eventkit_read_error(message or "EventKit read failed.", a, code="eventkit_read_failed", exit_code=1)
    items = []
    for item in result.get("items") or []:
        if not isinstance(item, dict):
            continue
        sanitized = {key: item[key] for key in EVENTKIT_ITEM_KEYS if key in item}
        sanitized.pop("id", None)
        items.append(sanitized)
    return {
        "source": "eventkit",
        "fidelity": "limited",
        "mode": mode,
        "idWarning": EVENTKIT_READ_ID_WARNING,
        "limitations": EVENTKIT_READ_LIMITATIONS,
        "items": items,
    }


def fmt_eventkit_item(item, verbose=False, indent=""):
    completed = bool(item.get("completed"))
    status = C.green("[x]") if completed else C.dim("[ ]")
    pri_val = _priority_value_from_item(item)
    pri_str = f" {_color_priority(pri_val)}" if PRI.get(pri_val, "") else ""
    title = safe_display(item.get("title") or "(untitled)")
    due_str = fmt_due(item.get("dueDate"), all_day=bool(item.get("allDay")))
    eventkit_id = safe_display(item.get("eventKitId") or "?")
    id_str = C.dim(f"EventKit ID: {eventkit_id}")
    if completed:
        title = C.dim(C.strikethrough(title))
        due_str = C.dim(due_str)
    parts = [f"{indent}{status}{pri_str} {title}{due_str} {id_str}"]
    if verbose:
        if item.get("list"):
            parts.append(f"{indent}    List: {safe_display(item['list'])}")
        if item.get("notes"):
            parts.append(f"{indent}    Notes: {C.dim(safe_display(item['notes'])[:200])}")
        if item.get("url"):
            parts.append(f"{indent}    URL: {C.dim(safe_display(item['url']))}")
        recurrence = recurrence_summary(item.get("recurrence"))
        if recurrence:
            parts.append(f"{indent}    Repeats: {C.magenta(recurrence)}")
        if item.get("allDay"):
            parts.append(f"{indent}    All-day: {C.cyan('Yes')}")
    return "\n".join(parts)


def print_eventkit_notice():
    print(C.yellow("EventKit limited read fallback"))
    print(C.dim(EVENTKIT_READ_ID_WARNING))
    print(C.dim("Unavailable in this mode: " + ", ".join(EVENTKIT_READ_LIMITATIONS[1:])))
    print()


def output_eventkit_read(payload, a, *, heading=None, empty_message="No reminders found", group_by_day=False):
    if getattr(a, "json", False):
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return
    items = payload["items"]
    print_eventkit_notice()
    if heading:
        print(C.bold(heading))
    if not items:
        print(empty_message)
        return
    if group_by_day:
        groups = {}
        for item in items:
            due = item.get("dueDate")
            try:
                dt = datetime.fromisoformat(due) if due else None
            except ValueError:
                dt = None
            key = dt.strftime("%Y-%m-%d") if dt else "No due date"
            label = dt.strftime("%A, %b %d") if dt else "No due date"
            today = datetime.now().replace(hour=0, minute=0, second=0, microsecond=0)
            if dt and dt.date() == today.date():
                label = "Today"
            elif dt and dt.date() == (today + timedelta(days=1)).date():
                label = "Tomorrow"
            groups.setdefault((key, label), []).append(item)
        for (_key, label), day_items in sorted(groups.items()):
            print(f"\n  {C.bold(label)}:")
            for item in day_items:
                print(fmt_eventkit_item(item, verbose=getattr(a, "verbose", False), indent="    "))
    else:
        for item in items:
            print(fmt_eventkit_item(item, verbose=getattr(a, "verbose", False), indent="  "))
    print(f"\n{len(items)} reminder{'s' if len(items) != 1 else ''}")


