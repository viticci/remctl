def fmt_due(v, colored=True, all_day=False):
    if not v: return ""
    if isinstance(v, datetime):
        dt = v
    elif isinstance(v, str):
        try:
            dt = datetime.fromisoformat(v)
        except ValueError:
            return ""
    else:
        dt = ts(v)
    if not dt:
        return ""
    now = datetime.now()
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)
    if dt.date() == today.date():
        label = f" (today {dt.strftime('%H:%M')})" if not all_day and (dt.hour or dt.minute) else " (today)"
        return label
    if dt.date() == (today + timedelta(days=1)).date():
        return " (tomorrow)"
    if dt < now:
        label = f" (overdue {(now - dt).days}d)"
        return C.red(label) if colored else label
    return f" ({dt.strftime('%Y-%m-%d')})"

def _color_priority(pri_val):
    """Color a priority marker based on level."""
    p = PRI.get(pri_val or 0, "")
    if not p: return ""
    if pri_val == 1: return C.red(p)
    if pri_val == 5: return C.yellow(p)
    if pri_val == 9: return C.green(p)
    return p


def _item_has(item, key):
    if isinstance(item, dict):
        return key in item
    keys = getattr(item, "keys", None)
    if callable(keys):
        try:
            return key in keys()
        except Exception:
            return False
    return False


def _item_get(item, key, default=None):
    if isinstance(item, dict):
        return item.get(key, default)
    if _item_has(item, key):
        return item[key]
    return default


def _item_is_all_day(item):
    if _item_has(item, "ZALLDAY"):
        return bool(_item_get(item, "ZALLDAY"))
    return bool(_item_get(item, "allDay", False))


def row_effective_due(item):
    """Raw due timestamp, with the local day for an all-day item."""
    due = _item_get(item, "ZDUEDATE", _item_get(item, "dueDate"))
    if _item_is_all_day(item):
        display = _item_get(item, "ZDISPLAYDATEDATE", _item_get(item, "displayDate"))
        if display is not None:
            return display
    return due


def row_shown_date(item):
    """Raw timestamp Reminders.app lists and labels the reminder at.

    Matches due_filter_expr: the display date when Reminders stores one,
    otherwise the due date.
    """
    display = _item_get(item, "ZDISPLAYDATEDATE", _item_get(item, "displayDate"))
    if display is not None:
        return display
    return row_effective_due(item)


