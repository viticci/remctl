def reminders_open_commands():
    commands = []
    app_path = find_app_bundle("Reminders.app")
    if app_path:
        commands.append(["open", str(app_path)])
    commands.extend([
        ["open", "-b", "com.apple.reminders"],
        ["open", "-a", "Reminders"],
    ])
    deduped = []
    seen = set()
    for command in commands:
        key = tuple(command)
        if key not in seen:
            seen.add(key)
            deduped.append(command)
    return deduped


def open_reminders_app_for_onboarding():
    errors = []
    for command in reminders_open_commands():
        try:
            proc = subprocess.run(
                command,
                capture_output=True,
                text=True,
                timeout=15,
            )
        except subprocess.TimeoutExpired:
            errors.append(f"{shlex.join(command)} timed out")
            continue
        except OSError as exc:
            errors.append(f"{shlex.join(command)}: {exc}")
            continue
        if proc.returncode == 0:
            time.sleep(1)
            return check_result("open_reminders", "ok", "Opened Reminders.app.")
        detail = (proc.stderr or proc.stdout).strip()
        errors.append(f"{shlex.join(command)}: {detail or f'exited {proc.returncode}'}")
    detail = "\n".join(errors) if errors else "Could not locate or open Reminders.app."
    return check_result(
        "open_reminders",
        "warn",
        detail,
        "Open Reminders.app manually, then rerun `remctl onboard`.",
    )


def bridge_access_check_for_onboarding():
    bridge_path = current_bridge_path()
    if not bridge_path.exists() or not os.access(bridge_path, os.X_OK):
        return check_result(
            "eventkit",
            "warn",
            f"{bridge_path} is unavailable.",
            "Run ./install.sh to install remctl-bridge, then rerun `remctl onboard`.",
        )

    result = bridge_call_result({"action": "authorize"})
    if not result or not isinstance(result.get("payload"), dict):
        return check_result(
            "eventkit",
            "warn",
            f"{bridge_path} did not return a valid authorization response.",
            "Rebuild remctl-bridge with ./install.sh, then rerun `remctl onboard`.",
        )

    payload = result["payload"]
    if result["returncode"] == 0 and payload.get("status") == "authorized":
        calendar_count = payload.get("calendarCount")
