def _fail_flag_applescript(a, r, operation, error_text):
    """Honest failure for flag/unflag: exit 1 with the real AppleScript error.

    There is deliberately no bridge fallback here — EventKit has no public
    flagged API, and the old fallback set priority=1 as a proxy while
    reporting success without ever touching ZFLAGGED."""
    hint = (
        f"remctl edit {a.id} --private --flagged"
        if operation == "flag"
        else f"remctl edit {a.id} --private --no-flagged"
    )
    title = safe_display(r["ZTITLE"] or "(untitled)")
    permission_target = (
        "the signed RemCTL Capability Host"
        if os.environ.get(CAPABILITY_HOST_ACTIVE_ENV) == "1"
        else "the deliberate direct caller"
    )
    message = (
        f"AppleScript could not {operation} #{a.id} ('{title}'): {error_text}. "
        f"EventKit cannot set the real flagged state, so there is no bridge fallback. "
        f"Approve Reminders Automation access for {permission_target} with `remctl onboard`; "
        f"if Reminders automation stays unavailable, use: {hint}"
    )
    if getattr(a, "json", False):
        print(
            json.dumps({"status": "error", "code": "applescript_flag_failed", "id": a.id, "message": message}),
            file=sys.stderr,
        )
    else:
        print(f"Error: {message}", file=sys.stderr)
    sys.exit(1)


def cmd_flag(a):
    db = open_db()
    r = q_reminder(db, a.id)
    if not r:
        print(f"Error: #{a.id} not found", file=sys.stderr)
        sys.exit(1)

    # AppleScript-only: EventKit has no public "flagged" API, so the bridge
    # can never set the real ZFLAGGED column. The reminder is addressed at
    # application level because group-nested lists are invisible to
    # `tell list "<name>"` (see osa_set_flagged_result).
    if not r["ZCKIDENTIFIER"]:
        _refuse_unsafe_title_fallback(r, "flag it", "The reminder has no stable identifier")
    ok, err = osa_set_flagged_result(r["ZCKIDENTIFIER"], flagged=True)
    if ok:
        if a.json:
            print(json.dumps({"status": "flagged", "id": a.id, "title": r["ZTITLE"]}))
        else:
            print(f"Flagged: {safe_display(r['ZTITLE'])}")
        return
    _fail_flag_applescript(a, r, "flag", err)

