def wait_for_new_list_id(name, before_ids, attempts=8):
    """The numeric id of a list just created, once the local store shows it.

    Compares ids before and after, so an older list with the same name is never
    mistaken for the new one. Returns None if the new row does not appear.
    """
    for attempt in range(attempts):
        try:
            new_ids = q_list_ids_named(open_db(), name) - set(before_ids)
        except Exception:
            # The list already exists; failing to read its id must not turn that into an error.
            return None
        if len(new_ids) == 1:
            return next(iter(new_ids))
        if new_ids:
            return None
        if attempt < attempts - 1:
            time.sleep(0.25)
    return None


