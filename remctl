    # --- Existing commands ---
    c = sub.add_parser("lists", help="List all iCloud reminder lists"); js(c); display_format(c)

    c = sub.add_parser("groups", help="List Reminders list groups"); js(c); display_format(c)

    c = sub.add_parser(
        "group-info",
        help="Show details for a Reminders list group",
        description="Show group ID, object UUID, child lists, reminder counts, and useful follow-up commands.",
        epilog=(
            "Examples:\n"
            "  remctl group-info Writing\n"
            "  remctl group-info --group-id 476 --json\n"
