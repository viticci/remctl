def stdout_is_interactive():
    """Honor broker-validated TTY state only inside the sealed host child."""

    try:
        if sys.stdout.isatty():
            return True
    except (AttributeError, OSError):
        pass
    return bool(
        os.environ.get(CAPABILITY_HOST_ACTIVE_ENV) == "1"
        and os.environ.get("REMCTL_CAPABILITY_STDOUT_TTY") == "1"
    )


def terminal_columns(default):
    """Return direct or broker-validated terminal width."""

    if os.environ.get(CAPABILITY_HOST_ACTIVE_ENV) == "1":
        raw_columns = os.environ.get("REMCTL_CAPABILITY_COLUMNS", "")
        try:
            columns = int(raw_columns)
        except ValueError:
            columns = 0
        if 20 <= columns <= 1000:
            return columns
    try:
        return os.get_terminal_size().columns
    except (ValueError, OSError):
        return default


