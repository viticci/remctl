_REMINDER_COLUMN_CACHE = {}

def reminder_has_column(db, column):
    key = (id(db), column)
    if key not in _REMINDER_COLUMN_CACHE:
        try:
            rows = db.execute("PRAGMA table_info(ZREMCDREMINDER)").fetchall()
            _REMINDER_COLUMN_CACHE[key] = any(row["name"] == column for row in rows)
        except Exception:
            _REMINDER_COLUMN_CACHE[key] = False
    return _REMINDER_COLUMN_CACHE[key]

def urgent_column_expr(db, table_alias="r"):
    if reminder_has_column(db, "ZISURGENTSTATEENABLEDFORCURRENTUSER"):
        return f"{table_alias}.ZISURGENTSTATEENABLEDFORCURRENTUSER"
    return "0"

def urgent_where_clause(db, table_alias="r"):
    if reminder_has_column(db, "ZISURGENTSTATEENABLEDFORCURRENTUSER"):
        return f"{table_alias}.ZISURGENTSTATEENABLEDFORCURRENTUSER = 1"
    return "0 = 1"

def due_date_delta_alerts_expr(db, table_alias="r"):
    if reminder_has_column(db, "ZDUEDATEDELTAALERTSDATA"):
        return f"{table_alias}.ZDUEDATEDELTAALERTSDATA"
    return "NULL"

def display_due_expr(db, table_alias="r"):
    if reminder_has_column(db, "ZDISPLAYDATEDATE"):
        return f"{table_alias}.ZDISPLAYDATEDATE"
    return "NULL"

def due_expr(table_alias="r"):
    return f"{table_alias}.ZDUEDATE"

def due_filter_expr(db, table_alias="r"):
    """Date used for due-window bucketing: the one Reminders.app shows.

    Reminders.app lists and labels a reminder at ZDISPLAYDATEDATE. For an
    all-day item it is the local day, while ZDUEDATE is a synthetic
    midnight-UTC timestamp. For a timed item it follows an absolute alarm at
    another time than the due date, such as one an EventKit due edit left at
    the old time, so Today keeps showing the reminder there.
    """
    due = f"{table_alias}.ZDUEDATE"
    if reminder_has_column(db, "ZDISPLAYDATEDATE"):
        return f"COALESCE({table_alias}.ZDISPLAYDATEDATE, {due})"
    return due

def rem_cols(db):
    return f"""r.Z_PK, r.ZTITLE, r.ZNOTES, r.ZCOMPLETED, r.ZFLAGGED, r.ZPRIORITY,
    {urgent_column_expr(db)} AS ZISURGENTSTATEENABLEDFORCURRENTUSER,
    {due_date_delta_alerts_expr(db)} AS ZDUEDATEDELTAALERTSDATA,
    {due_expr()} AS ZDUEDATE, {display_due_expr(db)} AS ZDISPLAYDATEDATE,
    r.ZALLDAY, r.ZCOMPLETIONDATE, r.ZCREATIONDATE,
    r.ZPARENTREMINDER, r.ZLIST, r.ZICSURL, r.ZCKIDENTIFIER, l.ZNAME as list_name,
    {_RECURRENCE_COLS}"""

def sort_reminder_rows_by_identifier_order(rows, identifier_order):
    """Return reminder rows in ReminderKit's persisted display order.

    Rows that are absent from the ordering payload keep their query order and
    follow the positioned rows. This preserves a useful fallback while a newly
    created reminder is still merging into the list ordering record.
    """
    positions = {}
    for index, identifier in enumerate(identifier_order or []):
        if isinstance(identifier, str) and identifier:
            positions.setdefault(identifier.casefold(), index)
    if not positions:
        return list(rows)

    def key(indexed_row):
        original_index, row = indexed_row
        identifier = _row_get(row, "ZCKIDENTIFIER")
        position = positions.get(identifier.casefold()) if isinstance(identifier, str) else None
        if position is None:
            return (1, original_index)
        return (0, position, original_index)

    return [row for _, row in sorted(enumerate(rows), key=key)]


def q_reminders(
    db,
    list_pk=None,
    completed=False,
    parent_pk=None,
    top_level=False,
    limit=500,
    manual_order=False,
):
    identifier_order = (
        q_list_reminder_order(db, list_pk)
        if manual_order and list_pk is not None
        else []
    )
    c, params = ["r.ZMARKEDFORDELETION = 0", "r.ZACCOUNT IS NOT NULL"], []
    if not completed: c.append("r.ZCOMPLETED = 0")
    if list_pk is not None: c.append("r.ZLIST = ?"); params.append(list_pk)
    if parent_pk is not None: c.append("r.ZPARENTREMINDER = ?"); params.append(parent_pk)
    elif top_level: c.append("(r.ZPARENTREMINDER IS NULL OR r.ZPARENTREMINDER = 0)")
    query = (
        f"SELECT {rem_cols(db)} FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l "
        f"ON r.ZLIST = l.Z_PK WHERE {' AND '.join(c)} AND l.Z_PK IS NOT NULL "
        f"ORDER BY r.Z_PK"
    )
    if not identifier_order:
        query += " LIMIT ?"
        params.append(limit)
    rows = db.execute(query, params).fetchall()
    if identifier_order:
        rows = sort_reminder_rows_by_identifier_order(rows, identifier_order)
    return rows[:limit]


def q_reminders_for_lists(
    db,
    list_pks,
    completed=False,
    top_level=False,
    limit=500,
    manual_order=False,
):
    if not list_pks:
        return []
    identifier_orders = (
        {list_pk: q_list_reminder_order(db, list_pk) for list_pk in list_pks}
        if manual_order
        else {}
    )
    has_identifier_order = any(identifier_orders.values())
    placeholders = ", ".join("?" for _ in list_pks)
    order_cases = " ".join(f"WHEN {int(pk)} THEN {idx}" for idx, pk in enumerate(list_pks))
    c = ["r.ZMARKEDFORDELETION = 0", "r.ZACCOUNT IS NOT NULL", f"r.ZLIST IN ({placeholders})"]
    if not completed:
        c.append("r.ZCOMPLETED = 0")
    if top_level:
        c.append("(r.ZPARENTREMINDER IS NULL OR r.ZPARENTREMINDER = 0)")
    query = (
        f"SELECT {rem_cols(db)} FROM ZREMCDREMINDER r LEFT JOIN ZREMCDBASELIST l "
        f"ON r.ZLIST = l.Z_PK WHERE {' AND '.join(c)} "
        f"ORDER BY CASE r.ZLIST {order_cases} ELSE {len(list_pks)} END, r.Z_PK"
    )
    params = list(list_pks)
    if not has_identifier_order:
        query += " LIMIT ?"
        params.append(limit)
    rows = db.execute(query, params).fetchall()
    if identifier_orders:
        rows_by_list = {list_pk: [] for list_pk in list_pks}
        for row in rows:
            rows_by_list.setdefault(_row_get(row, "ZLIST"), []).append(row)
        rows = [
            row
            for list_pk in list_pks
            for row in sort_reminder_rows_by_identifier_order(
                rows_by_list.get(list_pk, []),
                identifier_orders.get(list_pk),
            )
        ]
    return rows[:limit]


