    private_payload_needed = bool(list_private_appearance_payload(a, include_public_color_names=False)) or group_target_requested
    if private_payload_needed:
        require_private_metadata(a)
        preflight_db = open_db()
        group_ref = None
        if group_target_requested:
            group_ref = resolve_required_group_target_or_die(
                preflight_db,
                name=getattr(a, "group", None),
                group_id=getattr(a, "group_id", None),
            )
        existing = q_list_exact_name_count(preflight_db, a.name)
        if existing:
            print(
                f"Error: list already exists: {a.name}. Use list-edit with --list-id for existing lists.",
                file=sys.stderr,
            )
            sys.exit(1)
        request = {"action": "create_list", "name": a.name}
        request.update(list_private_appearance_payload(a, include_public_color_names=True))
        result = private_create_list_call(request, a.name)
        if not result or result.get("status") != "created":
            message = result.get("message") if isinstance(result, dict) else "private helper failed"
            print(f"Error: Failed to create list '{a.name}': {message}", file=sys.stderr)
            sys.exit(1)
        created_ref = None
        membership = None
        if group_ref is not None:
            for _ in range(8):
                created_db = open_db()
                resolved = resolve_list_ref(created_db, name=a.name)
                if resolved and not resolved.get("error"):
                    created_ref = resolved
                    membership = apply_private_list_parent_group(created_db, created_ref, group_ref, a=a)
                    break
                time.sleep(0.25)
            if created_ref is None:
                print(f"Error: created list '{a.name}' was not visible for group assignment.", file=sys.stderr)
                sys.exit(1)
        # Duplicate names were refused above, so any list with this name is the new one.
        created_id = created_ref["id"] if created_ref is not None else wait_for_new_list_id(a.name, set())
        if a.json:
            payload = {"status": "created", "name": a.name, "private": result}
            if created_id is not None:
                payload["id"] = created_id
            else:
                payload["warnings"] = ["list_id_unavailable: the list was created, but its numeric id was not visible yet. Find it with lists."]
            if created_ref is not None:
                payload["objectUUID"] = created_ref.get("objectUUID")
            if group_ref is not None:
                payload["group"] = {
                    "id": group_ref["id"],
                    "title": group_ref["title"],
                    "objectUUID": group_ref.get("objectUUID"),
                }
                payload["membership"] = membership
            print(json.dumps(payload, ensure_ascii=False))
        else:
            print(f"Created list: {safe_display(a.name)}")
            if group_ref is not None:
                print(f"Group: {safe_display(group_ref['title'])} (id: {group_ref['id']})")
            details = []
            if getattr(a, "color", None):
                details.append(f"color={normalize_list_color(a.color)}")
            if getattr(a, "symbol", None):
                details.append(f"symbol={a.symbol}")
            if getattr(a, "emoji", None):
                details.append(f"emoji={a.emoji}")
            if getattr(a, "groceries", False):
                details.append(f"groceries locale={normalize_grocery_locale(getattr(a, 'grocery_locale', None)) or DEFAULT_GROCERY_LOCALE_ID}")
            if details:
                print(f"Applied private metadata: {', '.join(details)}")
        return
    data = {"action": "create_list", "title": a.name}
    if hasattr(a, 'color') and a.color and is_supported_public_list_color(a.color):
        data["color"] = normalize_list_color(a.color)
    before_ids = list_ids_named_or_empty(a.name)
    bridge_result = None
    result = None
    if bridge_available():
        bridge_result = bridge_call_result(data)
        if bridge_result_ok(bridge_result, "created"):
            result = bridge_result["payload"]
        elif bridge_failure_is_access_error(bridge_result):
            fail_bridge_write(bridge_result, operation="create the list")
        elif bridge_failure_is_execution_error(bridge_result):
            fail_bridge_write(bridge_result, operation="create the list")
        else:
            try:
                db = open_db()
                if q_list_exact_name_count(db, a.name):
                    result = {"status": "created", "name": a.name}
                else:
                    if bridge_result.get("returncode") != 0:
                        print(
                            "Warning: remctl-bridge failed while creating the list; "
                            f"falling back to AppleScript. Bridge error: {bridge_failure_message(bridge_result)}",
                            file=sys.stderr,
                        )
                    result = create_list_with_applescript(a.name)
            except RemindersDBUnavailable:
                if bridge_result.get("returncode") != 0:
                    print(
                        "Warning: remctl-bridge failed while creating the list; "
                        f"falling back to AppleScript. Bridge error: {bridge_failure_message(bridge_result)}",
                        file=sys.stderr,
                    )
                result = create_list_with_applescript(a.name)
    else:
        result = create_list_with_applescript(a.name)
    if result and result.get("status") == "created":
        created_id = wait_for_new_list_id(a.name, before_ids)
        if a.json:
            payload = {"status": "created", "name": a.name}
            if created_id is not None:
                payload["id"] = created_id
            else:
                payload["warnings"] = ["list_id_unavailable: the list was created, but its numeric id was not visible yet. Find it with lists."]
            print(json.dumps(payload))
        else:
            print(f"Created list: {safe_display(a.name)}")
            if created_id is not None:
                print(f"ID: {created_id}")
    else:
        message = result.get("message") if isinstance(result, dict) else None
        print(f"Error: Failed to create list '{a.name}'" + (f": {message}" if message else ""), file=sys.stderr)
