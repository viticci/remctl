def _recurrence_week_label(week, day_name):
    """Render a weekday label pinned to a week-of-month ('4th Fri', 'last Fri')."""
    if not week:
        return day_name
    if week > 0:
        return f"{week}{RECURRENCE_ORDINAL_SUFFIXES.get(week, 'th')} {day_name}"
    if week == -1:
        return f"last {day_name}"
    back = -week
    return f"{back}{RECURRENCE_ORDINAL_SUFFIXES.get(back, 'th')}-last {day_name}"


def _recurrence_day_labels(recurrence):
    """Weekday labels for a rule, honoring week pinning.

    Reminders' stored blob (daysOfWeekDetailed) wins when present and uses
    weekNumber 0 for "any week"; bridge-bound rules carry a parallel
    weekNumbers list instead, which may be missing or short.
    """
    detailed = recurrence.get("daysOfWeekDetailed")
    pairs = []
    if isinstance(detailed, list) and detailed:
        for entry in detailed:
            if isinstance(entry, dict) and entry.get("dayOfTheWeek") is not None:
                pairs.append((entry.get("dayOfTheWeek"), entry.get("weekNumber")))
    else:
        weeks = recurrence.get("weekNumbers") or []
        for index, day in enumerate(recurrence.get("daysOfWeek") or []):
            pairs.append((day, weeks[index] if index < len(weeks) else 0))

    labels = []
    for day, week in pairs:
        try:
            week = int(week or 0)
        except (TypeError, ValueError):
            week = 0
        try:
            name = RECURRENCE_DAY_NAMES.get(int(day), str(day))
        except (TypeError, ValueError):
            name = str(day)
        labels.append(_recurrence_week_label(week, name))
    return labels


def recurrence_summary(recurrence):
    if not recurrence:
        return ""
    frequency = recurrence.get("frequency")
    interval = int(recurrence.get("interval") or 1)
    units = {
        "daily": ("day", "days"),
        "weekly": ("week", "weeks"),
        "monthly": ("month", "months"),
        "yearly": ("year", "years"),
    }
    if frequency not in units:
        return ""
    singular, plural = units[frequency]
    if interval == 1:
        label = frequency
    else:
        label = f"every {interval} {plural}"

    if frequency in {"weekly", "monthly", "yearly"}:
        names = _recurrence_day_labels(recurrence)
        if names:
            label += " " + ", ".join(names)

    days_of_month = recurrence.get("daysOfMonth") or []
    if frequency == "monthly" and days_of_month:
        label += " on " + ", ".join(str(day) for day in days_of_month)

    count = recurrence.get("count")
    if count:
        # Not " xN" — that now reads as the xN interval token in --recurrence input.
        label += f", {count} time{'' if count == 1 else 's'}"
    elif recurrence.get("endDate"):
        label += f" until {str(recurrence['endDate'])[:10]}"

    return label


def recurrence_badge(item):
    summary = recurrence_summary(_recurrence_from_item(item))
    return C.magenta(f"↻ {summary}") if summary else ""


