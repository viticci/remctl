    except (json.JSONDecodeError, TypeError):
        return {}
    counts = {}
    for membership in data.get("memberships", []):
        if membership.get("isObsolete"):
            continue
        group_id = membership.get("groupID")
        member_id = membership.get("memberID")
        if group_id and member_id:
            counts[group_id] = counts.get(group_id, 0) + 1
    return counts


def decode_manual_sort_hint_blob(blob):
    if blob is None:
        return None
    if isinstance(blob, memoryview):
        blob = blob.tobytes()
    if isinstance(blob, bytes):
        if blob[:1] == b"\x01":
            blob = blob[1:]
        try:
            blob = blob.decode("utf-8")
        except UnicodeDecodeError:
            return None
    elif isinstance(blob, str) and blob.startswith("\x01"):
        blob = blob[1:]
    if not isinstance(blob, str):
        return None
    try:
        payload = json.loads(blob)
    except (json.JSONDecodeError, TypeError):
        return None
    if not isinstance(payload, dict):
        return None
    top_level = payload.get("topLevelElementIDs", [])
    secondary = payload.get("secondaryLevelElementIDsByTopLevelElementID", {})
    if not isinstance(top_level, list) or not all(isinstance(item, str) and item for item in top_level):
        return None
    if not isinstance(secondary, dict):
        return None
    if any(
        not isinstance(key, str)
        or not isinstance(value, list)
        or not all(isinstance(item, str) and item for item in value)
        for key, value in secondary.items()
    ):
        return None
    return {
        "topLevelElementIDs": top_level,
        "secondaryLevelElementIDsByTopLevelElementID": secondary,
    }


def q_manual_sort_hint(db, list_type, list_id):
    try:
        entity = db.execute(
            "SELECT Z_ENT FROM Z_PRIMARYKEY WHERE Z_NAME = ?",
            (MANUAL_SORT_HINT_ENTITY,),
        ).fetchone()
    except sqlite3.OperationalError:
        return None
    if not entity:
        return None
    try:
        row = db.execute(
            "SELECT ZCKIDENTIFIER, ZLISTTYPERAWVALUE, ZLISTID, ZHINTDATA "
            "FROM ZREMCDOBJECT WHERE Z_ENT = ? AND ZMARKEDFORDELETION = 0 "
            "AND ZLISTTYPERAWVALUE = ? AND lower(ZLISTID) = lower(?) "
            "ORDER BY Z_PK DESC LIMIT 1",
            (entity["Z_ENT"], list_type, list_id),
        ).fetchone()
    except sqlite3.OperationalError:
        return None
    if not row or not row["ZCKIDENTIFIER"]:
        return None
    payload = decode_manual_sort_hint_blob(row["ZHINTDATA"])
    if payload is None:
        return None
    return {
        "objectUUID": row["ZCKIDENTIFIER"],
        "listType": row["ZLISTTYPERAWVALUE"],
        "listID": row["ZLISTID"],
        **payload,
    }


