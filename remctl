        sys.exit(1)
    if len(matches) > 1:
        print("Error: multiple custom smart lists match. Use --smart-list-id.", file=sys.stderr)
        for row in matches:
            print(f"  {row['Z_PK']}: {smart_list_display_name(row)}", file=sys.stderr)
        sys.exit(1)
    has_non_match_filter_changes = smart_list_filter_changes_from_args(a)
    has_match_flag_changes = (
        getattr(a, "match", None) is not None
        or getattr(a, "tag_match", None) is not None
        or getattr(a, "list_match", None) is not None
    )
    has_filter_changes = has_non_match_filter_changes or has_match_flag_changes
    has_appearance_changes = list_appearance_changes_from_args(a)
