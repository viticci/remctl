def onboarding_step(number, total, title, blurb=()):
    print()
    print(C.bold(f"Step {number} of {total} · {title}"))
    for line in blurb:
        print(C.dim(f"  {line}"))


def onboarding_line(status, text, *, fix=None, indent=2):
    glyph, paint = {
        "ok": ("✓", C.green),
        "warn": ("!", C.yellow),
        "fail": ("✗", C.red),
        "pending": ("○", C.dim),
        "info": ("→", C.dim),
    }[status]
    print(" " * indent + paint(glyph) + " " + text)
    if fix:
        for line in str(fix).splitlines():
            print(" " * (indent + 2) + C.dim(line))


def onboarding_ask(question, *, default_yes):
    """Ask a yes/no question; returns None when input is interrupted."""
    suffix = "[Y/n]" if default_yes else "[y/N]"
    try:
        answer = input(f"  {question} {suffix} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return None
    if not answer:
        return default_yes
    return answer in ("y", "yes")


def onboarding_today_count(cli_path):
    """How many reminders are due today or overdue, through the normal route; None on failure."""
    env = dict(os.environ, REMCTL_SKIP_ONBOARD="1", NO_COLOR="1")
    try:
        result = subprocess.run(
            [sys.executable, str(cli_path), "today", "--json"],
            capture_output=True, text=True, timeout=30, env=env, check=False,
        )
        if result.returncode != 0:
            return None
        rows = json.loads(result.stdout)
        return len(rows) if isinstance(rows, list) else None
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


def offer_mcp_connections(cli_path, *, interactive=True):
    """Onboarding step: connect the AI apps found on this Mac, one question each."""
    overview = mcp_overview(cli_path)
    detected = [client for client in overview["clients"] if client["installed"]]
    results = []
    if not detected:
        onboarding_line("info", "No supported AI app found on this Mac (Claude Code, Codex, Claude Desktop).")
        onboarding_line("info", "Any other MCP client can connect with the snippet from `remctl mcp config`.")
        return results
    for client in detected:
        label = client["name"]
        if client["configured"] and client.get("current") is not False:
            onboarding_line("ok", f"{label}: connected")
            continue
        verb = "Update" if client["configured"] else "Connect"
        if not interactive:
            onboarding_line("pending", f"{label}: not connected", fix=f"remctl mcp install --client {client['id']}")
            continue
        answer = onboarding_ask(f"{verb} {label}?", default_yes=True)
        if answer is None:
            break
        if not answer:
            onboarding_line("info", f"Skipped {label}. Later: remctl mcp install --client {client['id']}")
            continue
        result = mcp_install_client(client["id"], cli_path)
        results.append(result)
        if result.get("ok"):
            onboarding_line("ok", f"{label}: connected", fix=result.get("note"))
        else:
            onboarding_line("fail", f"{label}: {result.get('error')}")
    return results


def offer_tailscale(cli_path, ts, *, interactive=True):
    """Onboarding step: optionally serve the MCP tools to other tailnet devices."""
    if ts.get("configured"):
        if ts.get("active"):
            onboarding_line("ok", f"Already serving at {ts.get('url')}")
            onboarding_line("info", "Commands for another device: remctl mcp config --format tailscale")
        else:
            onboarding_line("warn", "Set up earlier, but not serving right now", fix="remctl mcp install --client tailscale   # repair")
        return None
    if not ts.get("running"):
        onboarding_line("warn", "Tailscale is installed but not connected.", fix="Open Tailscale and sign in, then run: remctl mcp install --client tailscale")
        return None
    if not ts.get("https"):
        onboarding_line(
            "warn",
            "Your tailnet has no HTTPS certificate for this Mac.",
            fix="In the Tailscale admin console, DNS page, enable MagicDNS and HTTPS certificates.\nThen run: remctl mcp install --client tailscale",
        )
        return None
    if not interactive:
        onboarding_line("pending", "Not set up", fix="remctl mcp install --client tailscale")
        return None
    answer = onboarding_ask("Set this up now?", default_yes=False)
    if not answer:
        onboarding_line("info", "Skipped. Later: remctl mcp install --client tailscale")
        return None
    print(C.dim("  Starting the endpoint and asking Tailscale to serve it…"))
    result = mcp_install_client("tailscale", cli_path)
    if result.get("ok"):
        onboarding_line("ok", f"Serving at {result['url']}")
        print_tailscale_snippets(result["snippets"], indent="    ")
    else:
        onboarding_line("fail", result.get("error") or "Setup failed")
    return result


def cmd_mcp(a):
    import remctl_mcp

    action = getattr(a, "mcp_action", None) or "serve"
    cli_path = mcp_cli_path()
    if action == "serve":
        widget = mcp_asset_path("remctl_mcp_widget.html")
        icons = remctl_mcp.icon_data_uri(mcp_asset_path("remctl-mcp-icon.png"))
        if getattr(a, "http", False):
            config = remctl_mcp.ensure_http_config(port=getattr(a, "port", None))
            transport = remctl_mcp.HTTPTransportConfig(token=config["token"], allowed_hosts=remctl_mcp.allowed_hosts_for(config),
                                                     token_path=remctl_mcp.http_config_path())
            server = remctl_mcp.build_server(cli_path, VERSION, widget_path=widget, icons=icons)
            host = getattr(a, "host", None) or config.get("host", "127.0.0.1")
            sys.exit(remctl_mcp.serve_http(server, transport, host=host, port=int(config["port"])))
        sys.exit(remctl_mcp.serve(cli_path, VERSION, widget_path=widget, icons=icons))

    json_mode = getattr(a, "json", False)
    if action in ("install", "remove"):
        clients = list(dict.fromkeys(getattr(a, "client", None) or []))
        if not clients or "all" in clients:
            detected = [client["id"] for client in remctl_mcp.detect_clients() if client["installed"]]
            clients = [client for client in clients if client != "all"] + [client for client in detected if client not in clients]
            if action == "remove" and "tailscale" not in clients:
                config = remctl_mcp.load_http_config()
                if config and config.get("tailscale"):
                    clients.append("tailscale")
            if not clients and action == "install":
                clients = ["other"]
        results = []
        for client in clients:
            if action == "install":
                results.append(mcp_install_client(client, cli_path, scope=getattr(a, "scope", "user"), port=getattr(a, "port", None)))
            else:
                results.append(mcp_remove_client(client, scope=getattr(a, "scope", "user")))
        if json_mode:
            print(json.dumps({"ok": all(result.get("ok") for result in results), "results": results}, indent=2))
        else:
            print(C.bold("RemCTL MCP " + action))
            for result in results:
                print_mcp_result(result)
            if action == "install" and any(result.get("client") == "claude-desktop" and result.get("ok") for result in results):
                print(C.dim("Prefer a one-click install? `remctl mcp bundle --open` builds a desktop extension for Claude Desktop."))
        if not all(result.get("ok") for result in results):
            sys.exit(1)
        return

    if action == "status":
        overview = mcp_overview(cli_path)
        if json_mode:
            print(json.dumps(overview, indent=2))
            return
        print(C.bold("RemCTL MCP status"))
        print(f"Server command: {' '.join(overview['server']['command'])}")
        for client in overview["clients"]:
            # The app's own config says whether it is connected. "installed" only
            # means its CLI is on this caller's PATH, and GUI apps, LaunchAgents,
            # and remote runners often lack ~/.local/bin.
            if client["configured"] and client.get("current") is not False:
                state = C.green("connected")
            elif client["configured"]:
                state = C.yellow(f"connected, but it {mcp_stale_reason(client)}; rerun remctl mcp install")
            elif not client["installed"]:
                state = C.dim("not installed")
            else:
                state = C.yellow("not connected")
            print(f"  {client['name']}: {state}")
        print(f"  Your other devices (Tailscale): {tailscale_state_text(overview['tailscale'])}")
        print(C.dim("Connect with `remctl mcp install`; get a generic snippet with `remctl mcp config`."))
        return

    if action == "token":
        if getattr(a, "rotate", False):
            config = remctl_mcp.rotate_http_token()
            loaded = remctl_mcp.http_agent_status()["loaded"]
            restarted = remctl_mcp.restart_http_agent() if loaded else False
            if loaded and not restarted:
                message = ("The new token was saved, but the running endpoint could not restart. "
                           "It may still accept the old token. Run `remctl mcp install --client tailscale` "
                           "to reload it before using the new token.")
                if json_mode:
                    print(json.dumps({"ok": False, "rotated": True, "restarted": False, "error": message}, indent=2))
                else:
                    print(message, file=sys.stderr)
                sys.exit(1)
            if json_mode:
                print(json.dumps({"ok": True, "token": config["token"], "rotated": True, "restarted": restarted}, indent=2))
                return
            print(C.bold("RemCTL MCP token rotated"))
            print(f"  {config['token']}")
            print(C.dim("  Devices that used the old token must be reconnected: remctl mcp config --format tailscale"))
            return
        config = remctl_mcp.load_http_config()
        if config is None:
            if json_mode:
                print(json.dumps({"ok": False, "error": "no HTTP endpoint configured"}, indent=2))
            else:
                print("No token yet. Run `remctl mcp install --client tailscale` first.", file=sys.stderr)
            sys.exit(1)
        print(json.dumps({"ok": True, "token": config["token"]}, indent=2) if json_mode else config["token"])
        return

    if action == "config":
        snippets = remctl_mcp.config_snippets(cli_path)
        fmt = getattr(a, "format_kind", "all")
        if fmt == "tailscale":
            config = remctl_mcp.load_http_config()
            if not config or not config.get("tailscale"):
                message = "Tailscale access is not set up. Run `remctl mcp install --client tailscale` first."
                if json_mode:
                    print(json.dumps({"ok": False, "error": message}, indent=2))
                else:
                    print(message, file=sys.stderr)
                sys.exit(1)
            remote = remctl_mcp.remote_snippets(config)
            if json_mode:
                print(json.dumps(remote, indent=2))
                return
            print(C.bold("Connect a device on your tailnet"))
            print(f"  Endpoint: {remote['url']}")
            print(f"  Token:    {remote['token']}")
            print(C.bold("Claude Code"))
            print(f"  {remote['claude-code']}")
            print(C.bold("Codex"))
            for line in remote["codex"].splitlines():
                print(f"  {line}")
            print(C.bold("Claude Desktop on another Mac (needs Node; uses the mcp-remote bridge)"))
            print(remote["claude-desktop"])
            print(C.bold("Other clients (Streamable HTTP with a bearer header)"))
            print(remote["json"])
            print(C.dim("Rotate the token with `remctl mcp token --rotate` if it leaks."))
            return
        if fmt == "all":
            if json_mode:
                print(json.dumps(snippets, indent=2))
                return
            print(C.bold("Stdio command"))
            print(f"  {snippets['command']}")
            print(C.bold("Claude Code"))
            print(f"  {snippets['claude-code']}")
            print(C.bold("Codex"))
            print(f"  {snippets['codex']}")
            print(C.bold("JSON (Claude Desktop and most other clients)"))
            print(snippets["json"])
            print(C.bold("TOML (Codex config.toml)"))
            print(snippets["toml"], end="")
            print(C.bold("YAML (Hermes Agent ~/.hermes/config.yaml)"))
            print(snippets["hermes"], end="")
            return
        print(snippets[fmt], end="" if fmt in {"toml", "hermes"} else "\n")
        return

    if action == "bundle":
        output = Path(a.output).expanduser() if getattr(a, "output", None) else remctl_mcp.bundle_default_output()
        icon = mcp_asset_path("remctl-mcp-icon-512.png") or mcp_asset_path("remctl-mcp-icon.png")
        path = remctl_mcp.build_bundle(cli_path, VERSION, output, icon_path=icon)
        result = {"ok": True, "path": str(path), "opened": False}
        if getattr(a, "open", False):
            try:
                subprocess.run(["open", str(path)], check=False, timeout=30)
                result["opened"] = True
            except (OSError, subprocess.SubprocessError):
                result["opened"] = False
        if json_mode:
            print(json.dumps(result, indent=2))
            return
        print(C.bold("RemCTL MCP bundle"))
        print(f"  {path}")
        if result["opened"]:
            print(C.dim("  Claude Desktop is showing the install dialog. Review it and click Install."))
        else:
            print(C.dim("  Double-click the file, or drag it onto Claude Desktop, to install it as an extension."))
        print(C.dim("  The extension launches the RemCTL installed on this Mac; reinstalling RemCTL keeps it working."))
        return

    print(f"remctl: error: unknown mcp action {action!r}", file=sys.stderr)
    sys.exit(2)

