    s.add_argument("--open", action="store_true", help="Open the bundle in Claude Desktop after building it")
    js(s)

    return p, sub


def main():
    p, sub = build_parser()
    original_argv = list(sys.argv[1:])
    # --- Parse ---
    a = parse_cli_args(p, sub)
    command_format = getattr(a, "command_format", None)
    if command_format:
        a.format = command_format

    # Image rendering: env vars provide defaults, CLI flags win.
    if not a.images:
        a.images = env_bool("REMCTL_IMAGES")
    if a.image_mode is None:
        env_mode = os.environ.get("REMCTL_IMAGE_MODE", "").strip().lower()
        if env_mode in IMAGE_MODES:
            a.image_mode = None if env_mode == "none" else env_mode
        elif env_mode:
            print(f"remctl: ignoring unknown REMCTL_IMAGE_MODE {env_mode!r} "
                  f"(expected one of: {', '.join(m for m in IMAGE_MODES if m != 'none')}, none)", file=sys.stderr)
    if a.image_mode == "none":
        a.images = False
        a.image_mode = None
    if a.image_width is None:
        env_width = os.environ.get("REMCTL_IMAGE_WIDTH", "").strip()
        try:
            a.image_width = int(env_width) if env_width else None
        except ValueError:
            a.image_width = None
        if env_width and a.image_width is None:
            print(f"remctl: ignoring invalid REMCTL_IMAGE_WIDTH {env_width!r} (expected a positive integer)", file=sys.stderr)
    if a.image_width is not None and a.image_width < 1:
        a.image_width = None

    # Set up color
    if a.no_color or os.environ.get("NO_COLOR") or not stdout_is_interactive():
        C.enabled = False

    # Propagate global --format to json flag where needed
    if a.format == "json":
        a.json = True

    route_via_host = _should_route_capability_host(a)
    onboarding_result = maybe_run_first_launch_onboarding(a)
    if onboarding_result is not None:
        sys.stdout.flush()
        sys.stderr.flush()

    # No command: splash screen + today
    if not a.cmd:
        a.no_overdue = False
        a.verbose = False
        if route_via_host:
            if a.format != "json":
                show_splash()
            _dispatch_capability_host(_no_command_host_argv(a), a)
            return
        if a.format == "json":
            a.json = True
            run_handler_with_fallback(a, cmd_today)
        else:
            a.json = False
            show_splash()
            run_handler_with_fallback(a, cmd_today)
        return

    if route_via_host:
        _dispatch_capability_host(_normalized_host_argv(original_argv, a), a)
        return

    # Route to command handler
    cmds = {
        "lists": cmd_lists,
        "groups": cmd_groups,
        "group-info": cmd_group_info,
        "group-create": cmd_group_create,
        "group-edit": cmd_group_edit,
        "group-delete": cmd_group_delete,
        "smart-lists": cmd_smart_lists,
        "templates": cmd_templates,
        "template-info": cmd_template_info,
        "show": cmd_show,
        "add": cmd_add,
        "done": cmd_done,
        "undone": cmd_undone,
        "edit": cmd_edit,
        "reminder-move": cmd_reminder_move,
        "deleted": cmd_deleted,
        "restore": cmd_restore,
        "delete": cmd_delete,
        "search": cmd_search,
        "today": cmd_today,
        "flagged": cmd_flagged,
        "urgent": cmd_urgent,
        "tags": cmd_tags,
        "subtasks": cmd_subtasks,
        "info": cmd_info,
        "sections": cmd_sections,
        "sharees": cmd_sharees,
        "list-info": cmd_list_info,
        "location-lookup": cmd_location_lookup,
        "stats": cmd_stats,
        "link": cmd_link,
        "open": cmd_open,
        "flag": cmd_flag,
        "unflag": cmd_unflag,
        "upcoming": cmd_upcoming,
        "overdue": cmd_overdue,
        "list-symbols": cmd_list_symbols,
        "list-create": cmd_list_create,
        "smart-list-create": cmd_smart_list_create,
        "smart-list-edit": cmd_smart_list_edit,
        "smart-list-delete": cmd_smart_list_delete,
        "template-create": cmd_template_create,
        "template-apply": cmd_template_apply,
        "template-delete": cmd_template_delete,
        "list-edit": cmd_list_edit,
        "list-pin": cmd_list_pin,
        "list-unpin": cmd_list_unpin,
        "list-rename": cmd_list_rename,
        "list-delete": cmd_list_delete,
        "section-create": cmd_section_create,
        "section-rename": cmd_section_rename,
        "section-delete": cmd_section_delete,
        "export": cmd_export,
        "import": cmd_import,
        "onboard": cmd_onboard,
        "doctor": cmd_doctor,
        "setup": cmd_setup,
        "permissions": cmd_permissions,
        "completion": cmd_completion,
        "mcp": cmd_mcp,
    }

    handler = cmds.get(a.cmd)
    if handler:
        run_handler_with_fallback(a, handler)
    else:
        p.print_help()


if __name__ == "__main__":
    main()
