def parse_recurrence_interval(token):
    """Parse an 'xN' interval token into 1..999, or None if it isn't one."""
    if not token.startswith("x"):
        return None
    digits = token[1:]
    # Bound the length before int(): CPython caps int() string conversion, so an
    # unbounded call would raise on a long digit run instead of returning None.
    if not 1 <= len(digits) <= 3 or not digits.isdecimal():
        return None
    value = int(digits)
    return value if 1 <= value <= 999 else None


def parse_nth_weekday_tokens(tokens):
    """Parse ['4th-fri', 'last-sun'] into parallel (daysOfWeek, weekNumbers)."""
    days = []
    weeks = []
    for token in tokens:
        match = RECURRENCE_NTH_WEEKDAY_RE.match(token)
        if not match:
            return None
        ordinal = match.group("ordinal")
        negative = match.group("negative")
        if ordinal:
            week = int(ordinal)
            if match.group("suffix") != RECURRENCE_ORDINAL_SUFFIXES[week]:
                return None
        elif negative:
            week = -int(negative)
        else:
            week = -1  # 'last-fri'
        days.append(RECURRENCE_DAY_TOKENS[match.group("day")])
        weeks.append(week)
    return days, weeks


def normalize_recurrence_object(spec):
    """Validate exported recurrence fields and translate them for EventKit."""
    fields = {"frequency", "interval", "daysOfWeek", "daysOfWeekDetailed", "weekNumbers",
              "daysOfMonth", "monthsOfYear", "daysOfYear", "weeksOfYear", "setPositions",
              "count", "endDate", "end"}
    if set(spec) - fields or spec.get("frequency") not in ("daily", "weekly", "monthly", "yearly"):
        return None
    result = dict(spec)
    interval = result.setdefault("interval", 1)
    if type(interval) is not int or not 1 <= interval <= 2**31 - 1:
        return None
    detailed = result.pop("daysOfWeekDetailed", None)
    if detailed is not None:
        if not isinstance(detailed, list) or not detailed:
            return None
        if any(not isinstance(day, dict) or set(day) - {"dayOfTheWeek", "weekNumber"}
               or "dayOfTheWeek" not in day for day in detailed):
            return None
        days = [day["dayOfTheWeek"] for day in detailed]
        weeks = [day.get("weekNumber", 0) for day in detailed]
        if "daysOfWeek" in result and result["daysOfWeek"] != days:
            return None
        if "weekNumbers" in result and result["weekNumbers"] != weeks:
            return None
        result.update(daysOfWeek=days, weekNumbers=weeks)
    for field, low, high in (("daysOfWeek", 1, 7), ("daysOfMonth", -31, 31),
                             ("monthsOfYear", 1, 12), ("daysOfYear", -366, 366),
                             ("weeksOfYear", -53, 53), ("setPositions", -366, 366)):
        if field not in result:
            continue
        values = result[field]
        if not isinstance(values, list) or not values or any(
            type(value) is not int or not low <= value <= high or value == 0 for value in values
        ):
            return None
    if "weekNumbers" in result:
        weeks = result["weekNumbers"]
        bound = {"monthly": 5, "yearly": 53}.get(result["frequency"], 0)
        if not isinstance(weeks, list) or len(weeks) != len(result.get("daysOfWeek", [])) or any(
            type(week) is not int or not -bound <= week <= bound for week in weeks
        ):
            return None
    if "count" in result:
        count = result["count"]
        if type(count) is not int or not 1 <= count <= 2**31 - 1:
            return None
    if "endDate" in result:
        end_date = result.pop("endDate")
        if "end" in result and result["end"] != end_date:
            return None
        result["end"] = end_date
    if "end" in result:
        if "count" in result or not isinstance(result["end"], str):
            return None
        try:
            end = datetime.fromisoformat(result["end"].replace("Z", "+00:00"))
            if end.tzinfo is not None:
                end = end.astimezone(timezone.utc)
            result["end"] = end.isoformat()
        except (ValueError, OverflowError):
            return None
    return result


def parse_recurrence(spec):
    """Parse recurrence spec like 'daily', 'weekly mon,wed,fri', 'monthly 1,15',
    'daily x2', 'monthly x2 4th-fri', or 'monthly last-fri'."""
    if isinstance(spec, dict):
        return normalize_recurrence_object(spec)
    if not isinstance(spec, str) or not spec:
        return None
    parts = spec.lower().split()
    if not parts:
        return None
    freq = parts[0]
    if freq not in {"daily", "weekly", "monthly", "yearly"}:
        return None

    rest = parts[1:]
    interval = 1
    if rest:
        parsed_interval = parse_recurrence_interval(rest[0])
        if parsed_interval is not None:
            interval = parsed_interval
            rest = rest[1:]

    result = {"frequency": freq, "interval": interval}
    if not rest:
        return result
    if len(rest) != 1:
        return None
    tokens = [d.strip() for d in rest[0].split(",") if d.strip()]
    if not tokens:
        return None

    if freq == "weekly":
        if any(token not in RECURRENCE_DAY_TOKENS for token in tokens):
            return None
        result["daysOfWeek"] = [RECURRENCE_DAY_TOKENS[token] for token in tokens]
        return result
    if freq == "monthly":
        nth = parse_nth_weekday_tokens(tokens)
        if nth is not None:
            result["daysOfWeek"], result["weekNumbers"] = nth
            return result
        if not all(len(token) <= 2 and token.isdecimal() for token in tokens):
            return None
        days = [int(token) for token in tokens]
        if any(day < 1 or day > 31 for day in days):
            return None
        result["daysOfMonth"] = days
        return result
    return None


def fail_invalid_recurrence(value):
    print(
        f"Error: could not parse recurrence {value!r}. Use daily, weekly, "
        "monthly, yearly, 'weekly mon,wed,fri', 'monthly 1,15', "
        "'monthly 4th-fri', 'monthly last-fri', 'monthly -1-fri', or an "
        "interval like 'daily x2' / 'monthly x2 4th-fri'. The xN interval (1-999) "
        "must come directly after the frequency, and nth-weekday tokens cannot be "
        "mixed with day-of-month numbers.",
        file=sys.stderr,
    )
    sys.exit(1)


def recurrence_or_die(value):
    recurrence = parse_recurrence(value)
    if recurrence is None:
        fail_invalid_recurrence(value)
    return recurrence

def parse_alarm(spec):
    """Normalize alarm spec for the Swift bridge.

    Relative alarms are converted to the bridge format (`-15m`, `-1h`, `-1d`).
    Absolute alarms are returned as ISO-like strings the bridge already accepts.
    """
    if not spec: return None
    sl = spec.lower().strip()
    m = re.match(r'^(\d+)(m|min|h|hr|d)$', sl)
    if m:
        n, unit = int(m.group(1)), m.group(2)
        if unit in ("m", "min"): return f"-{n}m"
        if unit in ("h", "hr"): return f"-{n}h"
        if unit == "d": return f"-{n}d"
    # Try ISO datetime
    for f in ("%Y-%m-%dT%H:%M", "%Y-%m-%d %H:%M", "%Y-%m-%dT%H:%M:%S"):
        try:
            dt = datetime.strptime(spec.strip(), f)
            return dt.isoformat()
        except ValueError:
            pass
    return None

def alarm_clear_requested(value):
    return str(value).strip().lower() in {"clear", "none", "off", "remove", "delete"}

EARLY_REMINDER_CLEAR_VALUES = {"clear", "none", "off", "never", "0", "0m", "0min"}
EARLY_REMINDER_UNIT_CODES = {
    "m": 0,
    "min": 0,
    "mins": 0,
    "minute": 0,
    "minutes": 0,
    "h": 1,
    "hr": 1,
    "hrs": 1,
    "hour": 1,
    "hours": 1,
    "d": 2,
    "day": 2,
    "days": 2,
    "w": 3,
    "wk": 3,
    "wks": 3,
    "week": 3,
    "weeks": 3,
    "mo": 4,
    "mon": 4,
    "month": 4,
    "months": 4,
}

def parse_early_reminder(spec):
    """Parse Early Reminder delta specs like 15m, 1h, 2d, 1w, 1mo, or clear."""
    if spec is None:
        return None
    value = str(spec).strip().lower()
    if value in EARLY_REMINDER_CLEAR_VALUES:
        return {"clear": True}
    value = re.sub(r"\s+before$", "", value).strip()
    m = re.match(r"^(\d+)\s*([a-z]+)$", value)
    if not m:
        return None
    amount = int(m.group(1))
    unit_code = EARLY_REMINDER_UNIT_CODES.get(m.group(2))
    if amount <= 0 or unit_code is None:
        return None
    singular, plural = DUE_DATE_DELTA_UNITS[unit_code]
    return {
        "unit": unit_code,
        "unitName": singular if amount == 1 else plural,
        "count": -amount,
        "value": amount,
    }

