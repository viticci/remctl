def format_command_columns(commands, width=88):
    commands = sorted(commands)
    lines = []
    current = ""
    for command in commands:
        token = command if not current else f", {command}"
        if current and len(current) + len(token) > width:
            lines.append(current)
            current = command
        else:
            current += token
    if current:
        lines.append(current)
    return lines


def first_command_token(argv):
    # Flags that consume the following token as their value; the value must
    # not be mistaken for the command name.
    skip_value_for = {"--format", "--image-mode", "--image-width"}
    iterator = iter(argv)
    for token in iterator:
        if token in {"-h", "--help", "--version"}:
            return None
        if token in skip_value_for:
            next(iterator, None)
            continue
        if token.startswith("--format="):
            continue
        if token.startswith("--image-mode=") or token.startswith("--image-width="):
            continue
        if token == "--no-color":
            continue
        if token.startswith("-"):
            continue
        return token
    return None


def suggest_command(command, choices):
    if command == "symbols" and "list-symbols" in choices:
        return "list-symbols"
    suffix_matches = [choice for choice in choices if choice.endswith(f"-{command}")]
    if len(suffix_matches) == 1:
        return suffix_matches[0]
    return None


def parse_cli_args(parser, subparsers, argv=None):
    """Parse argv with a friendly unknown-command error instead of argparse's.

    argv defaults to sys.argv[1:]. Kept separate from main() so tests can
    drive the real parser without running a command.
    """
    args = sys.argv[1:] if argv is None else argv
    command_token = first_command_token(args)
    if command_token and command_token not in subparsers.choices:
        print(f"remctl: error: unknown command: {command_token!r}", file=sys.stderr)
        suggestion = suggest_command(command_token, subparsers.choices)
        if suggestion:
            print(f"Did you mean: remctl {suggestion}", file=sys.stderr)
        print("Available commands:", file=sys.stderr)
        for line in format_command_columns(subparsers.choices):
            print(f"  {line}", file=sys.stderr)
        print("Run `remctl <command> --help` for command-specific options.", file=sys.stderr)
        sys.exit(2)
    return parser.parse_args(args)


def build_parser():
    """Construct the full CLI parser; returns (parser, subparsers action).

    Separated from main() so tests can drive real argument parsing.
    """
    p = argparse.ArgumentParser(
        prog=CLI_NAME,
        description=(
            "Power-user Reminders CLI. Normal installed commands run through the signed "
            "RemCTL Capability Host, which owns Full Disk Access, Reminders, and Automation."
        ),
        epilog=(
            "First install:\n"
            "  1. ./install.sh --bootstrap   # install the signed host and Python 3.10+ CLI\n"
            f"  2. {CLI_NAME} onboard             # request host access; opens the FDA guide if needed\n"
            "  3. After any Full Disk Access change, restart the signed host\n"
            f"  4. {CLI_NAME} doctor --for-agent  # verify access.effective and protocol v2 after restart\n"
            f"  5. {CLI_NAME} mcp install         # connect Claude Code, Codex, Claude Desktop/Cowork (onboard offers this)\n"
            "Upgrade or reinstall:\n"
            "  1. ./install.sh\n"
            f"  2. {CLI_NAME} doctor --for-agent\n"
            f"  3. Run {CLI_NAME} onboard only if doctor reports host permission trouble\n"
            "     These steps are for an existing signed host. After official 1.7.1, run onboard\n"
            "     because 1.8.0 installs the host for the first time.\n"
            f"Repair: {CLI_NAME} permissions full-disk-access   # reopen the host-only FDA guide\n"
            "\n"
            "Examples:\n"
            f"  {CLI_NAME} onboard\n"
            f"  {CLI_NAME} today\n"
            f"  {CLI_NAME} add \"Buy milk\" -d tomorrow\n"
            f"  {CLI_NAME} info 847 --images\n"
            f"  {CLI_NAME} setup --shell auto\n"
            f"  {CLI_NAME} permissions full-disk-access\n"
            "\n"
            f"Use `{CLI_NAME} onboard --help`, `{CLI_NAME} permissions --help`, `{CLI_NAME} setup --help`, and `{CLI_NAME} doctor --help`\n"
            "for onboarding details.\n"
            "\n"
            "Private metadata writes are unsupported and opt-in: pass --private on "
            "add/edit/reminder-move; list-create/list-edit/list-pin/list-unpin; "
            "section-create/section-rename/section-delete; group-create/group-edit/group-delete; "
            "smart-list-create/smart-list-edit/smart-list-delete; or "
            "template-create/template-apply/template-delete."
        ),
        formatter_class=HelpFormatter,
        allow_abbrev=False,
    )
    p.add_argument("--version", action="version", version=VERSION)
    p.add_argument("--no-color", action="store_true", help="Disable color output")
    p.add_argument("--format", choices=["plain", "table", "json"], default="plain",
                   help="Output format")
    p.add_argument("--images", action="store_true",
                   help="Render image attachments inline (info always; list commands with --verbose)")
    p.add_argument("--image-mode", choices=list(IMAGE_MODES), default=None,
                   help="Image rendering protocol (default: auto-detect)")
    p.add_argument("--image-width", type=int, default=None,
                   help="Image render width in terminal cells (default: ~40%% of terminal width, capped 24-100)")

    sub = p.add_subparsers(dest="cmd", metavar="command")

    def js(c): c.add_argument("--json", action="store_true", help="Output machine-readable JSON")
    def location_alarm_arguments(c):
        c.add_argument("--location-title", help="Guarded metadata: location alarm title; saved through EventKit")
        c.add_argument("--latitude", type=float, help="Guarded metadata: location alarm latitude; saved through EventKit")
        c.add_argument("--longitude", type=float, help="Guarded metadata: location alarm longitude; saved through EventKit")
        c.add_argument(
            "--location-address",
            help="Guarded metadata: street address for the location alarm; resolved to coordinates before anything is written",
        )
        c.add_argument("--address", dest="location_address", help=argparse.SUPPRESS)
        c.add_argument("--radius", type=float, default=100.0, help="Guarded metadata: location alarm radius in meters (up to 100000)")
        c.add_argument("--proximity", choices=["arriving", "leaving"], default="arriving", help="Guarded metadata: location alarm trigger direction")
    def img(c):
        # Re-declare the global image flags so they also parse after the command name.
        # argparse.SUPPRESS keeps an unused re-declaration from overwriting the
        # value the global option already stored in the namespace.
        c.add_argument("--images", action="store_true", default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        c.add_argument("--image-mode", choices=list(IMAGE_MODES), default=argparse.SUPPRESS, help=argparse.SUPPRESS)
        c.add_argument("--image-width", type=int, default=argparse.SUPPRESS, help=argparse.SUPPRESS)
    def display_format(c):
        c.add_argument(
            "--format",
            dest="command_format",
            choices=["plain", "table", "json"],
            default=None,
            help="Output format for this read command",
        )
    def vb(c): c.add_argument("-v", "--verbose", action="store_true")
    def eventkit_read(c):
        c.add_argument(
            "--via-eventkit",
