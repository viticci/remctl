def check_result(name, status, detail, fix=None):
    return {"name": name, "status": status, "detail": detail, "fix": fix}


def print_check_report(title, checks):
    fail_count = sum(1 for check in checks if check["status"] == "fail")
    warn_count = sum(1 for check in checks if check["status"] == "warn")
    status_labels = {
        "ok": C.green("OK"),
        "warn": C.yellow("WARN"),
        "fail": C.red("FAIL"),
    }
    if title:
        print(C.bold(title))
    for check in checks:
        print(f"[{status_labels[check['status']]}] {check['name']}: {check['detail']}")
        if check.get("fix"):
            for line in str(check["fix"]).splitlines():
                print(f"      {C.dim(line)}")
    summary = (
        f"{len(checks)} checks, {warn_count} warning{'s' if warn_count != 1 else ''}, "
        f"{fail_count} failure{'s' if fail_count != 1 else ''}"
    )
    if fail_count:
        print(C.red(summary))
    elif warn_count:
        print(C.yellow(summary))
    else:
        print(C.green(summary))
    return warn_count, fail_count


def _normalize_terminal_app_name(value):
    if not value:
        return None
    return KNOWN_TERMINAL_APPS.get(value.strip().lower())


def app_bundle_from_path_hint(value):
    if not value:
        return None
    match = re.search(r"(/.*?\.app)(?:/|\s|$)", str(value))
    if not match:
        return None
    path = Path(match.group(1)).expanduser().resolve(strict=False)
    return path if path.name.endswith(".app") and path.exists() else None


def find_app_bundle_by_identifier(bundle_id):
    if not bundle_id:
        return None
    if not re.match(r"^[A-Za-z0-9_.-]+$", str(bundle_id)):
        return None
    try:
        proc = subprocess.run(
            ["mdfind", f"kMDItemCFBundleIdentifier == '{bundle_id}'"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        path = Path(line.strip()).expanduser()
        if path.name.endswith(".app") and path.exists():
            return path.resolve()
    return None


def bundle_context_from_environment():
    bundle_id = os.environ.get("__CFBundleIdentifier")
    bundle_path = find_app_bundle_by_identifier(bundle_id) if bundle_id else None
    if bundle_path:
        return {
            "app": bundle_path.name,
            "path": str(bundle_path),
            "bundle_id": bundle_id,
            "source": "__CFBundleIdentifier",
        }
    for env_name in ("GHOSTTY_RESOURCES_DIR", "GHOSTTY_BIN_DIR"):
        bundle_path = app_bundle_from_path_hint(os.environ.get(env_name))
        if bundle_path:
            return {
                "app": bundle_path.name,
                "path": str(bundle_path),
                "bundle_id": bundle_id,
                "source": env_name,
            }
    return None


def detect_terminal_app_name():
    env_name = _normalize_terminal_app_name(os.environ.get("TERM_PROGRAM"))
    if env_name:
        return env_name

    pid = os.getppid()
    for _ in range(6):
        if not pid or pid <= 1:
            break
        try:
            proc = subprocess.run(
                ["ps", "-o", "ppid=", "-o", "comm=", "-p", str(pid)],
                capture_output=True,
                text=True,
                timeout=5,
            )
        except (OSError, subprocess.TimeoutExpired):
            break
        if proc.returncode != 0:
            break
        line = proc.stdout.strip()
        if not line:
            break
        parts = line.split(None, 1)
        if len(parts) != 2:
            break
        next_pid, command = parts
        label = _normalize_terminal_app_name(Path(command).name)
        if label:
            return label
        try:
            pid = int(next_pid)
        except ValueError:
            break
    return None


def process_info(pid):
    try:
        proc = subprocess.run(
            ["ps", "-p", str(pid), "-o", "ppid=", "-o", "ucomm=", "-o", "command="],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    line = proc.stdout.strip()
    if not line:
        return None
    parts = line.split(None, 2)
    if len(parts) < 2:
        return None
    try:
        parent_pid = int(parts[0])
    except ValueError:
        parent_pid = None
    name = parts[1]
    command = parts[2] if len(parts) > 2 else name
    return {"pid": int(pid), "ppid": parent_pid, "name": name, "command": command}


def process_ancestry(limit=8):
    ancestry = []
    pid = os.getppid()
    for _ in range(limit):
        if not pid or pid <= 1:
            break
        info = process_info(pid)
        if not info:
            break
        ancestry.append(info)
        pid = info.get("ppid")
    return ancestry


def _app_name_from_process_name(name):
    if not name:
        return None
    lower = name.lower()
    if "codex" in lower:
        return "Codex.app"
    return _normalize_terminal_app_name(name)


def doctor_execution_context():
    ancestry = process_ancestry()
    parent = ancestry[0] if ancestry else None
    terminal_app = detect_terminal_app_name()
    bundle_context = bundle_context_from_environment()
    host_app = bundle_context["app"] if bundle_context else terminal_app
    host_app_path = bundle_context["path"] if bundle_context else None
    host_bundle_id = bundle_context["bundle_id"] if bundle_context else None
    host_app_source = bundle_context["source"] if bundle_context else ("terminal" if terminal_app else None)
    effective_context = "Terminal" if terminal_app else "unknown"

    for proc in ancestry:
        app_name = _app_name_from_process_name(proc.get("name"))
        if app_name:
            if bundle_context and app_name == "Ghostty.app" and bundle_context["app"] != "Ghostty.app":
                continue
            host_app = app_name
            resolved = find_app_bundle(app_name) if app_name.endswith(".app") else None
            host_app_path = str(resolved) if resolved else host_app_path
            host_app_source = "process"
            if "codex" in app_name.lower():
                effective_context = "Codex"
            elif app_name.endswith(".app"):
                effective_context = app_name.removesuffix(".app")
            break
        bundle_path = app_bundle_from_path_hint(proc.get("command"))
        if bundle_path:
            host_app = bundle_path.name
            host_app_path = str(bundle_path)
            host_app_source = "process_command"
            effective_context = host_app.removesuffix(".app")
            break
    if bundle_context and host_app == bundle_context["app"]:
        effective_context = host_app.removesuffix(".app")

    return {
        "python": sys.executable,
        "pid": os.getpid(),
        "parent_process": parent,
        "terminal_app": terminal_app,
        "host_app": host_app,
        "host_app_path": host_app_path,
        "host_bundle_id": host_bundle_id,
        "host_app_source": host_app_source,
        "effective_context": effective_context,
    }


def capability_host_status_snapshot():
    """Return a diagnostic host snapshot even if an older transport raises."""

    try:
        status = remctl_broker.status(timeout=10)
    except remctl_broker.CapabilityHostError as exc:
        return {
            "status": "error",
            "installed": False,
            "available": False,
            "ready": False,
            "fullReady": False,
            "protocolVersion": None,
            "expectedProtocolVersion": getattr(remctl_broker, "PROTOCOL_VERSION", None),
            "scope": None,
            "socket": None,
            "launchAgent": None,
            "app": None,
            "permissions": None,
            "commandScope": None,
            "error": {"code": getattr(exc, "code", "capability_host_error"), "message": str(exc)},
        }
    return status if isinstance(status, dict) else {
        "status": "error",
        "installed": False,
        "available": False,
        "ready": False,
        "fullReady": False,
        "error": {"code": "invalid_host_status", "message": "Capability Host returned an invalid status."},
    }


def capability_host_requested_mode():
    try:
        return remctl_broker.mode()
    except (ValueError, remctl_broker.CapabilityHostError):
        return "invalid"


def capability_host_install_marker_path():
    return (
        current_permissions_path().resolve(strict=True).parent
        / ".remctl-capability-host-app"
    )


def capability_host_is_effective(status):
    mode = capability_host_requested_mode()
    if mode == "direct":
        return False
    return bool(
        mode == "force"
        or status.get("installed")
        or status.get("available")
    )


def capability_host_target_specs(status=None):
    snapshot = status or capability_host_status_snapshot()
    app = snapshot.get("app") if isinstance(snapshot.get("app"), dict) else {}
    app_path_text = app.get("path")
    signature = app.get("signature") if isinstance(app.get("signature"), dict) else {}
    if (
        snapshot.get("installed") is not True
        or app.get("installed") is not True
        or not isinstance(app_path_text, str)
        or not app_path_text
        or app.get("bundleIdentifier") != remctl_broker.BUNDLE_IDENTIFIER
        or signature.get("valid") is not True
        or signature.get("identifier") != remctl_broker.BUNDLE_IDENTIFIER
        or not isinstance(signature.get("teamID"), str)
        or not signature.get("teamID")
        or signature.get("teamID") == "not set"
        or not isinstance(signature.get("cdhash"), str)
        or not signature.get("cdhash")
        or not isinstance(signature.get("designatedRequirement"), str)
        or not signature.get("designatedRequirement")
    ):
        return []
    app_path = Path(app_path_text)
    if (
        not app_path.is_absolute()
        or app_path_text != str(app_path)
        or app_path.name != "RemCTL Capability Host.app"
        or app_path.is_symlink()
        or not app_path.is_dir()
    ):
        return []
    try:
        if app_path.resolve(strict=True) != app_path:
            return []
    except OSError:
        return []
    try:
        marker_path = capability_host_install_marker_path()
    except OSError:
        return []
    installed_path = remctl_broker._installed_path_marker(
        marker_path,
        expected_name="RemCTL Capability Host.app",
    )
    if installed_path != app_path:
        return []
    return [{
        "title": "RemCTL Capability Host.app",
        "path": app_path_text,
        "subtitle": (
            "The signed RemCTL host is the only Full Disk Access target needed by "
            "Terminal, Hermes, Codex, and other callers."
        ),
    }]


def capability_host_full_disk_access_fix(status):
    targets = capability_host_target_specs(status)
    if not targets:
        return "Reinstall the RemCTL Capability Host, then rerun `remctl onboard`."
    path = targets[0]["path"]
    return (
        "Open System Settings > Privacy & Security > Full Disk Access and add only "
        f"the signed RemCTL Capability Host: {path}. Then restart the host and rerun "
        "`remctl doctor --for-agent`."
    )


def find_app_bundle(app_name):
    if not app_name:
        return None
    candidates = [
        Path.home() / "Applications" / app_name,
        Path("/Applications") / app_name,
        Path("/System/Applications") / app_name,
        Path("/System/Applications/Utilities") / app_name,
    ]
    for candidate in candidates:
        if candidate.exists():
            return candidate.resolve()
    try:
        proc = subprocess.run(
            ["mdfind", f"kMDItemFSName == '{app_name}'c"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if proc.returncode != 0:
        return None
    for line in proc.stdout.splitlines():
        path = Path(line.strip())
        if path.name == app_name and path.exists():
            return path.resolve()
    return None


def capability_host_start_fix(status):
    """Distinguish a stopped, signed installation from missing permission grants."""
    app = status.get("app") or {}
    agent = status.get("launchAgent") or {}
    if (app.get("installed") and (app.get("signature") or {}).get("valid")
            and app.get("bundleIdentifier") == remctl_broker.BUNDLE_IDENTIFIER
            and (app.get("signature") or {}).get("identifier") == remctl_broker.BUNDLE_IDENTIFIER
            and agent.get("contractValid") is True and agent.get("loaded") is False
            and isinstance(agent.get("path"), str) and Path(agent["path"]).is_absolute()):
        import shlex
        path = agent["path"]
        fix = ("The signed host is installed, but its LaunchAgent is not loaded. Run "
               f"`launchctl bootstrap gui/{os.getuid()} {shlex.quote(path)}`, then `remctl doctor --for-agent`.")
        if Path(path).parent != Path.home() / "Library/LaunchAgents":
            fix += " This directory is not loaded at login; rerun the updated installer with the original PREFIX to migrate it."
        return fix
    return None


def full_disk_access_fix_text(*, rerun_command="remctl doctor", mention_onboard=False, host_status=None):
    mode = capability_host_requested_mode()
    if mode == "direct":
        return "\n".join([
            "Direct mode bypasses the signed RemCTL Capability Host, so Full Disk Access is caller-scoped and self-managed.",
            "The normal RemCTL permission helper does not configure direct callers.",
            f"Manage the deliberate direct caller yourself, then rerun `{rerun_command}`.",
        ])
    if host_status is not None:
        start_fix = capability_host_start_fix(host_status)
        if start_fix:
            return start_fix
    return "\n".join([
        "The signed RemCTL Capability Host is unavailable, so effective Full Disk Access is not ready.",
        "Reinstall RemCTL to restore the exact signed host, then run `remctl onboard`.",
        "Use `remctl permissions full-disk-access` to add only that host in System Settings.",
        f"After adding or changing Full Disk Access, restart the signed host, then rerun `{rerun_command}`.",
    ])


def copy_to_clipboard(text):
    try:
        proc = subprocess.run(
            ["pbcopy"],
            input=text,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def open_full_disk_access_settings():
    for settings_url in FULL_DISK_ACCESS_SETTINGS_URLS:
        try:
            proc = subprocess.run(
                ["open", settings_url],
                capture_output=True,
                text=True,
                timeout=15,
            )
        except (OSError, subprocess.TimeoutExpired):
            continue
        if proc.returncode == 0:
            return True
    return False


