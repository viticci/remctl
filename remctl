    1: "Sun",
    2: "Mon",
    3: "Tue",
    4: "Wed",
    5: "Thu",
    6: "Fri",
    7: "Sat",
}

RECURRENCE_DAY_TOKENS = {"sun": 1, "mon": 2, "tue": 3, "wed": 4, "thu": 5, "fri": 6, "sat": 7}

RECURRENCE_ORDINAL_SUFFIXES = {1: "st", 2: "nd", 3: "rd", 4: "th", 5: "th"}


