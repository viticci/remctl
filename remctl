        "SELECT a.Z_PK AS alarm_id, a.ZTRIGGER AS trigger_id, "
        "t.Z_ENT AS trigger_entity, t.ZTIMEINTERVAL AS time_interval, "
        "t.ZDATECOMPONENTSDATA AS date_components, t.ZTITLE AS location_title, "
        "t.ZLATITUDE AS latitude, t.ZLONGITUDE AS longitude, t.ZRADIUS AS radius, "
        "t.ZADDRESS AS address, t.ZPROXIMITY AS proximity "
        "FROM ZREMCDOBJECT a "
